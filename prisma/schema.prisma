// ---------------------------------------------------------------
// SCHEMA DATABASE — CRM Carrozzerie (multi-tenant)
//
// Strategia multi-tenant scelta: "shared database, shared schema"
// con colonna tenantId su ogni tabella + Row Level Security (RLS)
// a livello Postgres come seconda barriera oltre all'app layer.
// È la strategia più economica da operare per un SaaS con molti
// tenant piccoli/medi (una carrozzeria = poche decine di utenti),
// e scala facilmente a centinaia di tenant senza gestire N database
// separati. Se in futuro un cliente enterprise richiede isolamento
// fisico dei dati, si può migrare selettivamente quel tenant verso
// uno schema/database dedicato senza toccare il resto.
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider  = "postgresql"
  
}

// -----------------------------
// TENANCY
// -----------------------------

model Tenant {
  id             String    @id @default(cuid())
  ragioneSociale String
  partitaIva     String?   @unique
  piano          Plan      @default(TRIAL)
  trialEndsAt    DateTime?
  // Punto 28 (dati demo): un tenant creato dallo script di seed demo, mai
  // da una registrazione reale. Serve a: escluderlo dal blocco abbonamento
  // scaduto (una demo non deve mai interrompersi), ed è la barriera che lo
  // script di seed controlla per rifiutarsi di scrivere su un tenant vero.
  isDemo         Boolean   @default(false)
  limiteAnalisiIAMensile Int?
  limiteAssistenteIAMensile Int?

  // Billing (Stripe). Nessuna di queste colonne contiene mai un segreto:
  // sono identificativi pubblici (customer/subscription/price id) o stati,
  // mai chiavi API. Le chiavi vivono solo in variabili d'ambiente.
  stripeCustomerId       String?                 @unique
  stripeSubscriptionId   String?                 @unique
  subscriptionStatus     SubscriptionStatus      @default(TRIALING)
  fatturazionePeriodicita FatturazionePeriodicita @default(MENSILE)
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean                 @default(false)
  utentiExtra            Int                     @default(0)
  creditiAIAcquistati    Int                     @default(0)
  earlyAdopter           Boolean                 @default(false)
  // Modalità Tecnico: di default un tecnico non può avere due lavorazioni
  // IN_CORSO insieme (evita di sommare per errore ore su due pratiche);
  // l'admin può abilitarlo esplicitamente per i casi in cui serve davvero.
  consentiLavorazioniSimultanee Boolean @default(false)
  createdAt      DateTime  @default(now())

  briefingSettings BriefingSettings?
  briefings BriefingReport[]
  delaySettings DelaySettings?
  delayPlans DelayPlan[]
  delayForecasts DelayForecast[]
  delayDecisions DelayDecision[]
  trackedParts TrackedPart[]
  partBlocks VehiclePartBlock[]
  partDocuments TrackedPartDocument[]
  profitRecords ProfitRecord[]
  profitSettings ProfitSettings?
  users          User[]
  clients        Client[]
  vehicles       Vehicle[]
  quotes         Quote[]
  appointments   Appointment[]
  parts          Part[]
  loanerCars     LoanerCar[]
  supplierOrders SupplierOrder[]
  sinistri       Sinistro[]
  aiAnalyses  AiAnalysisLog[]
  assistantLogs AiAssistantLog[]
  portalAccesses PortalAccess[]
  damageAnalyses DamageAnalysis[]
  damageItems    DamageItem[]
  insuranceGapAnalyses   InsuranceGapAnalysis[]
  insuranceGapItems      InsuranceGapItem[]
  insuranceGapSuggestions InsuranceGapSuggestion[]
  whatsappTemplates WhatsappTemplate[]
  whatsappMessages  WhatsappMessage[]
  portalActions     PortalAction[]
  portalDocuments   PortalDocument[]
  workOrders        WorkOrder[]
  workOrderTimeEntries WorkOrderTimeEntry[]
  workOrderEventi   WorkOrderEvento[]
  qcChecklistItems  QcChecklistItem[]
  qcInspections     QcInspection[]
  qcCheckResults    QcCheckResult[]
  qcNonConformita   QcNonConformita[]
  qcEventi          QcEvento[]
  loanerCarPhotos    LoanerCarPhoto[]
  loanerBookings     LoanerBooking[]
  loanerBookingPhotos LoanerBookingPhoto[]
  notifications      Notification[]
  gdprRichieste      GdprRichiesta[]
  tickets            Ticket[]


  @@map("tenants")
}

enum Plan {
  TRIAL
  STARTER
  PRO
  PREMIUM_AI
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  SUSPENDED
}

enum FatturazionePeriodicita {
  MENSILE
  ANNUALE
}

// -----------------------------
// UTENTI / RUOLI
// -----------------------------

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  nome         String
  cognome      String
  email        String   @unique
  passwordHash String
  ruolo        Role     @default(TECNICO)
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  emailVerificata        Boolean   @default(false)
  emailVerificaToken      String?   @unique
  emailVerificaScadenza   DateTime?
  resetPasswordToken      String?   @unique
  resetPasswordScadenza   DateTime?

  // GDPR: versione dei Termini/Privacy accettati in fase di registrazione
  // e quando (obbligatorio al punto 18 del prompt SaaS — "versione
  // Termini/Privacy" con timestamp).
  condizioniAccettateVersione String?
  condizioniAccettateAt       DateTime?

  vehiclesAssegnati   Vehicle[]      @relation("TecnicoAssegnato")
  stageChanges        StageHistory[]
  timeEntries         TimeEntry[]
  auditLogs         AuditLog[]
  appuntamentiTecnico Appointment[]  @relation("TecnicoAppuntamento")
  analisiDanniCreate  DamageAnalysis[]
  correzioniDanni     DamageItem[]
  analisiGapCreate         InsuranceGapAnalysis[]
  correzioniGapAssicurazione InsuranceGapItem[]
  whatsappTemplateAggiornati WhatsappTemplate[]
  whatsappMessaggiInviati    WhatsappMessage[]
  portalActionsGestite       PortalAction[]
  portalDocumentiCaricati    PortalDocument[]
  workOrdersAssegnati        WorkOrder[]            @relation("WorkOrderTecnico")
  workOrdersCreati           WorkOrder[]            @relation("WorkOrderCreatore")
  workOrderTimeEntries       WorkOrderTimeEntry[]   @relation("WorkOrderTimeEntryTecnico")
  workOrderTimeCorrezioni    WorkOrderTimeEntry[]   @relation("WorkOrderTimeEntryCorrettore")
  workOrderEventiAttore      WorkOrderEvento[]      @relation("WorkOrderEventoAttore")
  qcIspezioniIniziate        QcInspection[]         @relation("QcInspectionIniziataDa")
  qcIspezioniApprovate       QcInspection[]         @relation("QcInspectionApprovataDa")
  qcEsitiAggiornati          QcCheckResult[]
  qcNonConformitaResponsabile QcNonConformita[]      @relation("QcNonConformitaResponsabile")
  qcNonConformitaCreate      QcNonConformita[]       @relation("QcNonConformitaCreata")
  qcEventiAttore             QcEvento[]              @relation("QcEventoAttore")
  loanerBookingsCreate       LoanerBooking[]
  notifications              Notification[]
  gdprRichieste              GdprRichiesta[]
  tickets                    Ticket[]

  @@index([tenantId])
  @@map("users")
}

enum Role {
  ADMIN
  ACCETTATORE
  TECNICO
  AMMINISTRAZIONE
}

// -----------------------------
// CLIENTI
// -----------------------------

model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  nome          String
  cognome       String
  telefono      String?
  email         String?
  codiceFiscale String?
  partitaIva    String?
  indirizzo     String?
  noteInterne   String?
  createdAt     DateTime @default(now())

  // Consenso privacy per le comunicazioni automatiche WhatsApp: nessun
  // messaggio viene mai inviato senza notificheWhatsappConsenso = true.
  // notificheWhatsappAttive permette di sospendere le notifiche per questo
  // cliente anche a consenso già dato (es. su sua richiesta esplicita),
  // senza dover revocare il consenso stesso.
  notificheWhatsappConsenso   Boolean   @default(false)
  notificheWhatsappConsensoAt DateTime?
  notificheWhatsappAttive     Boolean   @default(true)

  // GDPR: a seguito di una richiesta di cancellazione, i dati identificativi
  // vengono anonimizzati (non cancellati) per non rompere pratiche/preventivi
  // già collegati, necessari per obblighi contabili/di garanzia.
  datiAnonimizzati Boolean   @default(false)
  anonimizzatoAt   DateTime?

  vehicles     Vehicle[]
  quotes       Quote[]
  documents    Document[]
  appointments Appointment[]
  sinistri     Sinistro[]
  loanerBookings LoanerBooking[]
  whatsappMessages WhatsappMessage[]

  @@index([tenantId])
  @@index([tenantId, telefono])
  @@map("clients")
}

// -----------------------------
// VEICOLI + WORKFLOW
// -----------------------------

model Vehicle {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  appointments Appointment[]
  sinistri     Sinistro[]
  portalAccesses PortalAccess[]

  marca   String
  modello String
  targa   String
  vin     String?
  colore  String?
  km      Int?

  compagniaAssicurativa String?
  numeroSinistro        String?
  perito                String?

  stage     WorkflowStage @default(ACCETTAZIONE)
  tecnicoId String?
  tecnico   User?         @relation("TecnicoAssegnato", fields: [tecnicoId], references: [id])

  dataIngresso          DateTime  @default(now())
  dataPrevistaConsegna  DateTime?
  dataConsegnaEffettiva DateTime?
  firmaConsegnaDataUrl String?   @db.Text
  firmatarioConsegna   String?
  dataFirmaConsegna    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stimaIA     Json?
  stimaIAAt   DateTime?

  delayPlan DelayPlan?
  delayForecasts DelayForecast[]
  delayDecisions DelayDecision[]
  trackedParts TrackedPart[]
  partBlocks VehiclePartBlock[]
  profitRecord ProfitRecord?
  photos       Photo[]
  quotes       Quote[]
  stageHistory StageHistory[]
  damageAnalyses DamageAnalysis[]
  insuranceGapAnalyses InsuranceGapAnalysis[]
  whatsappMessages WhatsappMessage[]
  portalActions PortalAction[]
  portalDocuments PortalDocument[]
  workOrders WorkOrder[]
  qcInspections QcInspection[]
  loanerBookings LoanerBooking[]

  @@index([tenantId])
  @@index([tenantId, targa])
  @@index([tenantId, stage])
  @@map("vehicles")
}

enum WorkflowStage {
  ACCETTAZIONE
  PREVENTIVO
  ATTESA_APPROVAZIONE
  ORDINE_RICAMBI
  IN_LAVORAZIONE
  PREPARAZIONE
  VERNICIATURA
  LUCIDATURA
  CONTROLLO_QUALITA
  LAVAGGIO
  PRONTA_CONSEGNA
  CONSEGNATA
}

// Log immutabile di ogni cambio stato: alimenta i KPI (tempo medio
// per stadio, tempo fermo auto, produttività tecnico) e la timeline
// mostrata al cliente nel portale.
model StageHistory {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  fromStage WorkflowStage?
  toStage   WorkflowStage

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id])

  changedAt DateTime @default(now())

  @@index([vehicleId])
  @@map("stage_history")
}

// -----------------------------
// FOTOGRAFIE
// -----------------------------

model Photo {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  fase      FasePhoto
  url       String // path su object storage (S3-compatibile)
  createdAt DateTime  @default(now())

  timeline Json @default("{}")
  timelineVersion Int @default(1)
  timelineEdits PhotoTimelineEdit[]

  // Di default visibile (comportamento storico invariato): lo staff può
  // togliere singole foto dal portale cliente senza eliminarle (es. scatti
  // di dettaglio non adatti a essere mostrati al cliente).
  visibilePortale Boolean @default(true)

  @@index([vehicleId])
  @@map("photos")
}

enum FasePhoto {
  PRIMA
  DURANTE
  DOPO
}

// -----------------------------
// PREVENTIVI
// -----------------------------

model Quote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  stato       QuoteStatus @default(BOZZA)
  imponibile  Decimal     @db.Decimal(10, 2)
  aliquotaIva Decimal     @default(22.00) @db.Decimal(4, 2)
  totale      Decimal     @db.Decimal(10, 2)

  pdfUrl    String?
  inviatoAt DateTime?
  firmaDataUrl    String?   @db.Text
  firmatarioNome  String?
  firmatoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]
  damageItems DamageItem[]
  insuranceGapAnalyses InsuranceGapAnalysis[]

  @@index([tenantId])
  @@index([tenantId, stato])
  @@map("quotes")
}

enum QuoteStatus {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  tipo           QuoteItemType
  descrizione    String
  quantita       Decimal       @default(1) @db.Decimal(10, 2)
  prezzoUnitario Decimal       @db.Decimal(10, 2)

  insuranceGapItems InsuranceGapItem[]

  @@map("quote_items")
}

enum QuoteItemType {
  MANODOPERA
  RICAMBIO
  VERNICE
  ALTRO
}

// -----------------------------
// AI DAMAGE ASSISTANT
// -----------------------------
// Modulo nuovo e separato dalla vecchia "Stima danni IA" (Vehicle.stimaIA,
// vedi POST /api/vehicles/:id/analizza-danni): quella resta invariata e
// continua a funzionare com'è. Questo modulo è più strutturato — un danno
// per riga invece di una stima unica testuale — pensato per generare voci
// di preventivo riga per riga, sempre con conferma umana obbligatoria.

// Una "sessione" di analisi: un gruppo di foto mandate insieme all'IA, che
// genera N DamageItem (uno per ogni danno individuato separatamente).
model DamageAnalysis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  creatoDaId String?
  creatoDa   User?   @relation(fields: [creatoDaId], references: [id])

  photoIds       Json // array di Photo.id analizzati in questa sessione
  rispostaGrezza Json? // risposta testuale grezza dell'IA: debug e miglioramento futuro del prompt

  createdAt DateTime @default(now())

  items DamageItem[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("damage_analyses")
}

// Un singolo danno individuato dall'IA. I campi "*AI" sono il risultato
// originale del modello e non vengono mai sovrascritti: restano come
// confronto con i campi correnti (modificabili dall'operatore) per capire
// dove l'IA sbaglia più spesso — base per migliorare il prompt in futuro.
model DamageItem {
  id               String         @id @default(cuid())
  damageAnalysisId String
  damageAnalysis   DamageAnalysis @relation(fields: [damageAnalysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Valori originali suggeriti dall'IA — immutabili.
  parteAI                 String
  posizioneAI             String?
  tipologiaDannoAI        String
  gravitaAI               DamageSeverity
  lavorazioneAI           String?
  necessitaSostituzioneAI Boolean @default(false)
  confidenzaPercento      Int? // 0-100: quanto l'IA è sicura di questo rilevamento
  vociPreventivoAI        Json // voci suggerite: array di {tipo, descrizione, quantita, prezzoUnitario}

  // Valori correnti: partono identici a quelli AI, l'operatore li corregge liberamente.
  parte                 String
  posizione             String?
  tipologiaDanno        String
  gravita               DamageSeverity
  lavorazioneSuggerita  String?
  necessitaSostituzione Boolean @default(false)
  vociPreventivo        Json
  noteOperatore         String?

  modificatoManualmente Boolean   @default(false)
  modificatoDaId        String?
  modificatoDa          User?     @relation(fields: [modificatoDaId], references: [id])
  modificatoAt          DateTime?

  // Preventivo bozza in cui questo danno è stato eventualmente incluso.
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([damageAnalysisId])
  @@map("damage_items")
}

enum DamageSeverity {
  LIEVE
  MEDIA
  GRAVE
}

// -----------------------------
// INSURANCE GAP ANALYSIS
// -----------------------------
// Confronto tra il preventivo interno e il documento (perizia/preventivo)
// ricevuto dall'assicurazione. Sola lettura/proposta: l'IA classifica ogni
// voce del preventivo interno come corrispondente, con differenza o
// mancante nel documento assicurazione, e suggerisce elementi da
// verificare — non dichiara mai automaticamente una voce dovuta o corretta.
// Riservato a ADMIN/AMMINISTRAZIONE (confronto importi/prezzi).

model InsuranceGapAnalysis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  sinistroId String?
  sinistro   Sinistro? @relation(fields: [sinistroId], references: [id])

  documentName    String
  documentMime    String
  documentSize    Int
  documentContent Bytes

  rispostaGrezza Json? // risposta testuale grezza dell'IA: debug e miglioramento futuro del prompt

  totalePreventivoInterno         Decimal  @db.Decimal(10, 2)
  totaleRiconosciutoAssicurazione Decimal? @db.Decimal(10, 2)
  differenza                      Decimal? @db.Decimal(10, 2)

  creatoDaId String?
  creatoDa   User?   @relation(fields: [creatoDaId], references: [id])
  createdAt  DateTime @default(now())

  items        InsuranceGapItem[]
  suggerimenti InsuranceGapSuggestion[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("insurance_gap_analyses")
}

// Una riga per ciascuna voce del preventivo interno selezionato: i campi
// "*AI" sono la lettura originale del documento assicurazione fatta
// dal modello e restano immutabili; l'operatore corregge solo i campi
// correnti (utile per capire dove l'IA legge male i documenti).
model InsuranceGapItem {
  id         String                @id @default(cuid())
  analysisId String
  analysis   InsuranceGapAnalysis  @relation(fields: [analysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id])

  // Snapshot della voce del preventivo interno al momento dell'analisi.
  descrizione    String
  tipo           QuoteItemType
  quantita       Decimal @db.Decimal(10, 2)
  prezzoUnitario Decimal @db.Decimal(10, 2)

  // Lettura originale del documento assicurazione fatta dall'IA — immutabile.
  trovatoAI                      Boolean @default(false)
  descrizioneAssicurazioneAI     String?
  quantitaAssicurazioneAI        Decimal? @db.Decimal(10, 2)
  prezzoUnitarioAssicurazioneAI  Decimal? @db.Decimal(10, 2)
  statoAI                        InsuranceGapStatus

  // Valori correnti: partono identici a quelli AI, l'operatore li corregge liberamente.
  quantitaAssicurazione       Decimal? @db.Decimal(10, 2)
  prezzoUnitarioAssicurazione Decimal? @db.Decimal(10, 2)
  stato                       InsuranceGapStatus
  noteOperatore               String?

  modificatoManualmente Boolean   @default(false)
  modificatoDaId        String?
  modificatoDa          User?     @relation(fields: [modificatoDaId], references: [id])
  modificatoAt          DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([analysisId])
  @@map("insurance_gap_items")
}

enum InsuranceGapStatus {
  CORRISPONDE
  DIFFERENZA
  MANCANTE
}

// Possibili elementi dimenticati suggeriti dall'IA, mai legati a una voce
// specifica del preventivo: solo un promemoria da verificare professionalmente.
model InsuranceGapSuggestion {
  id         String               @id @default(cuid())
  analysisId String
  analysis   InsuranceGapAnalysis @relation(fields: [analysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  voce     String
  motivo   String
  scartata Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([analysisId])
  @@map("insurance_gap_suggestions")
}

// -----------------------------
// MAGAZZINO RICAMBI
// -----------------------------

model Part {
 trackedParts TrackedPart[]
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  codice         String
  descrizione    String
  giacenza       Int      @default(0)
  scortaMinima   Int      @default(0)
  prezzoAcquisto Decimal  @db.Decimal(10, 2)
  prezzoVendita  Decimal? @db.Decimal(10, 2)
  fornitore      String?

  movements PartMovement[]

  @@unique([tenantId, codice])
  @@index([tenantId])
  @@map("parts")
}

model PartMovement {
  id     String @id @default(cuid())
  partId String
  part   Part   @relation(fields: [partId], references: [id])

  tipo      MovementType
  quantita  Int
  createdAt DateTime     @default(now())

  @@map("part_movements")
}

enum MovementType {
  CARICO
  SCARICO
}

// -----------------------------
// ORDINI FORNITORI
// -----------------------------

model SupplierOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fornitore            String
  stato                OrderStatus @default(IN_ATTESA)
  dataOrdine           DateTime    @default(now())
  dataConsegnaPrevista DateTime?
  note                 String?

  items SupplierOrderItem[]

  @@index([tenantId])
  @@map("supplier_orders")
}

model SupplierOrderItem {
 trackedPart TrackedPart?
  id              String        @id @default(cuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id])

  // partId non è collegato con una relation esplicita a Part (come già
  // fatto per LoanerBooking.clientId): la voce d'ordine deve poter
  // esistere anche per ricambi non ancora presenti a magazzino.
  partId           String?
  descrizione      String
  quantitaOrdinata Int
  quantitaRicevuta Int      @default(0)
  prezzoUnitario   Decimal? @db.Decimal(10, 2)

  @@map("supplier_order_items")
}

enum OrderStatus {
  IN_ATTESA
  PARZIALE
  CONSEGNATO
}

// -----------------------------
// AUTO SOSTITUTIVE
// -----------------------------

enum LoanerFuelType {
  BENZINA
  DIESEL
  GPL
  METANO
  ELETTRICA
  IBRIDA
}

enum LoanerFuelLevel {
  VUOTO
  UN_QUARTO
  META
  TRE_QUARTI
  PIENO
}

// Solo i due stati che non derivano dalle prenotazioni: DISPONIBILE/
// PRENOTATA/ASSEGNATA si calcolano sempre dalle prenotazioni stesse (mai
// duplicati in un campo a parte, per non rischiare che vadano fuori
// sincrono), MANUTENZIONE e NON_DISPONIBILE sono invece decisioni dello
// staff che nessuna prenotazione può dedurre da sola.
enum LoanerCarStatoManuale {
  MANUTENZIONE
  NON_DISPONIBILE
}

model LoanerCar {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  targa   String
  marca   String
  modello String
  km      Int?
  carburante LoanerFuelType @default(BENZINA)

  assicurazioneScadenza DateTime?
  revisioneScadenza     DateTime?
  manutenzioneScadenza  DateTime?
  note                  String?   @db.Text

  // Tariffa giornaliera interna (centesimi): base per calcolare il costo
  // interno di un utilizzo, da poter attribuire alla pratica nel Profit
  // Tracker. Nullo finché lo staff non la imposta: nessun costo stimato
  // senza un valore inserito esplicitamente.
  tariffaGiornalieraCents Int?

  statoManuale LoanerCarStatoManuale?

  // Deprecato: sostituito dallo stato calcolato da prenotazioni +
  // statoManuale. Mantenuto per compatibilità con dati/integrazioni
  // esistenti, aggiornato in automatico dalle route ma mai più letto
  // come fonte di verità da questo modulo.
  disponibile Boolean @default(true)

  bookings LoanerBooking[]
  photos   LoanerCarPhoto[]

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("loaner_cars")
}

model LoanerCarPhoto {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  loanerCarId String
  loanerCar   LoanerCar @relation(fields: [loanerCarId], references: [id])

  content Bytes
  mime    String
  size    Int

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([loanerCarId])
  @@map("loaner_car_photos")
}

enum LoanerBookingStato {
  PRENOTATA
  ASSEGNATA
  RESTITUITA
  ANNULLATA
}

enum LoanerPhotoFase {
  CONSEGNA
  RESTITUZIONE
}

model LoanerBooking {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  loanerCarId String
  loanerCar   LoanerCar @relation(fields: [loanerCarId], references: [id])

  clientId String
  client   Client  @relation(fields: [clientId], references: [id])
  // Pratica per cui viene data l'auto sostitutiva (es. il veicolo del
  // cliente è in carrozzeria): facoltativo, non tutte le prenotazioni
  // nascono da una pratica interna.
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Calendario disponibilità: intervallo previsto della prenotazione,
  // indipendente da quando l'auto viene fisicamente consegnata/resa.
  dataInizioPrevista DateTime
  dataFinePrevista   DateTime?

  dataConsegna        DateTime?
  kmIniziali          Int?
  carburanteIniziale  LoanerFuelLevel?
  firmaClienteDataUrl String?          @db.Text
  firmatarioNome      String?

  dataRestituzione  DateTime?
  kmFinali          Int?
  carburanteFinale  LoanerFuelLevel?
  danniRiscontrati  String?           @db.Text
  noteRestituzione  String?           @db.Text

  // Costo interno calcolato (in centesimi) per il periodo di utilizzo:
  // esposto per poterlo attribuire manualmente come costo "sostitutiva"
  // sulla pratica nel Profit Tracker (mai scritto lì in automatico).
  costoInternoCents        Int?
  attribuitoProfitRecordId String?

