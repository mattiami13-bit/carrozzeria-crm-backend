 tenant Tenant @relation(fields: [tenantId], references: [id])
 partId String
 part TrackedPart @relation(fields: [partId], references: [id])
 name String
 mime String
 size Int
 content Bytes
 createdAt DateTime @default(now())
 @@index([tenantId, partId])
 @@map("tracked_part_documents")
}

model PhotoTimelineEdit {
 id String @id @default(cuid())
 photoId String
 photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
 actorId String
 before Json
 after Json
 createdAt DateTime @default(now())
 @@index([photoId, createdAt])
 @@map("photo_timeline_edits")
}

// -----------------------------
// COMUNICAZIONI WHATSAPP (workflow pratica)
// -----------------------------
// Inviate esclusivamente tramite Twilio come Meta Business Solution
// Provider ufficiale per WhatsApp Business (nessuna libreria non ufficiale).
// Un evento = un cambio di stato della pratica (WorkflowStage) oppure un
// evento speciale non legato allo stage (es. ricambio in ritardo, segnalato
// manualmente dall'operatore perché non è un vero cambio di stato).
// L'amministratore decide, evento per evento, se è attivo e con quale testo.

enum WhatsappEvento {
  ACCETTAZIONE
  PREVENTIVO
  ATTESA_APPROVAZIONE
  ORDINE_RICAMBI
  IN_LAVORAZIONE
  PREPARAZIONE
  VERNICIATURA
  LUCIDATURA
  CONTROLLO_QUALITA
  LAVAGGIO
  PRONTA_CONSEGNA
  CONSEGNATA
  RICAMBIO_RITARDO
}

model WhatsappTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  evento WhatsappEvento
  attivo Boolean @default(false)
  testo  String  @db.Text

  aggiornatoDaId String?
  aggiornatoDa   User?    @relation(fields: [aggiornatoDaId], references: [id])
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([tenantId, evento])
  @@index([tenantId])
  @@map("whatsapp_templates")
}

enum WhatsappMessageStato {
  INVIATO
  CONSEGNATO
  LETTO
  FALLITO
  RISPOSTA_RICEVUTA
}

// Registro immutabile di ogni messaggio WhatsApp inviato da una pratica:
// testo effettivo, stato di consegna (aggiornato dal webhook Twilio),
// eventuale errore ed eventuale risposta ricevuta dal cliente.
model WhatsappMessage {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  clientId  String
  client    Client @relation(fields: [clientId], references: [id])

  evento   WhatsappEvento
  testo    String @db.Text
  telefono String

  stato               WhatsappMessageStato @default(INVIATO)
  providerMessageSid  String?
  errore              String? @db.Text

  rispostaTesto String?   @db.Text
  rispostaAt    DateTime?

  inviatoDaId String?
  inviatoDa   User?   @relation(fields: [inviatoDaId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([vehicleId])
  @@index([providerMessageSid])
  @@map("whatsapp_messages")
}

// -----------------------------
// QUALITY CONTROL (obbligatorio prima di "Pronta")
// -----------------------------
// Checklist configurabile dal tenant: ogni riga è un controllo (chiave
// stabile + etichetta modificabile), con un flag "critico" che decide se
// un esito NON_CONFORME su quella voce blocca l'approvazione QC. Stesso
// pattern "salvato o bozza di default" già usato per WhatsappTemplate:
// finché l'admin non la personalizza, la route restituisce la checklist
// di esempio senza scrivere nulla nel database.
model QcChecklistItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  chiave    String
  etichetta String
  ordine    Int     @default(0)
  critico   Boolean @default(true)
  attivo    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chiave])
  @@index([tenantId])
  @@map("qc_checklist_items")
}

enum QcInspectionStato {
  IN_CORSO
  APPROVATO
}

enum QcEsito {
  OK
  DA_VERIFICARE
  NON_CONFORME
  NA
}

// Un'ispezione QC per pratica: nasce con una riga QcCheckResult per ogni
// voce attiva della checklist al momento dell'avvio (così una modifica
// successiva alla checklist non altera retroattivamente ispezioni già in
// corso). Il passaggio della pratica a "Pronta" richiede che l'ultima
// ispezione sia APPROVATO — verificato in vehicles.js, non qui.
model QcInspection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  stato QcInspectionStato @default(IN_CORSO)

  iniziataDaId String?
  iniziataDa   User?   @relation("QcInspectionIniziataDa", fields: [iniziataDaId], references: [id])

  approvatoDaId String?
  approvatoDa   User?     @relation("QcInspectionApprovataDa", fields: [approvatoDaId], references: [id])
  approvatoAt   DateTime?

  createdAt DateTime @default(now())

  checkResults    QcCheckResult[]
  nonConformita   QcNonConformita[]
  eventi          QcEvento[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("qc_inspections")
}

model QcCheckResult {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id])

  chiave    String
  etichetta String
  critico   Boolean

  esito QcEsito? // null = non ancora valutato
  note  String?  @db.Text

  aggiornatoDaId String?
  aggiornatoDa   User?     @relation(fields: [aggiornatoDaId], references: [id])
  aggiornatoAt   DateTime?

  nonConformita QcNonConformita[]

  createdAt DateTime @default(now())

  @@unique([inspectionId, chiave])
  @@index([tenantId])
  @@index([inspectionId])
  @@map("qc_check_results")
}

enum QcNonConformitaStato {
  APERTA
  IN_LAVORAZIONE
  RISOLTA
  CHIUSA
}

model QcNonConformita {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id])
  checkResultId String?
  checkResult   QcCheckResult? @relation(fields: [checkResultId], references: [id])

  descrizione String @db.Text

  fotografia     Bytes?
  fotografiaMime String?
  fotografiaSize Int?

  responsabileId String?
  responsabile   User?   @relation("QcNonConformitaResponsabile", fields: [responsabileId], references: [id])

  azioneCorrettiva String?  @db.Text
  data             DateTime @default(now())
  stato            QcNonConformitaStato @default(APERTA)

  creataDaId String?
  creataDa   User?   @relation("QcNonConformitaCreata", fields: [creataDaId], references: [id])

  chiusaAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([inspectionId])
  @@map("qc_non_conformita")
}

enum QcEventoTipo {
  ISPEZIONE_AVVIATA
  ESITO_AGGIORNATO
  NON_CONFORMITA_APERTA
  NON_CONFORMITA_AGGIORNATA
  NON_CONFORMITA_CHIUSA
  QC_APPROVATO
}

// Audit log immutabile di ogni azione QC: esiti, non conformità aperte o
// chiuse, approvazione finale — sempre con autore e timestamp.
model QcEvento {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id])

  tipo     QcEventoTipo
  dettagli Json?

  attoreId String?
  attore   User?   @relation("QcEventoAttore", fields: [attoreId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([inspectionId])
  @@map("qc_eventi")
}

model BriefingSettings {
 tenantId String @id
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
 data Json
 updatedAt DateTime @updatedAt
 @@map("briefing_settings")
}
model BriefingReport {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
 day String
 kind String
 data Json
 createdAt DateTime @default(now())
 resolutions BriefingResolution[]
 @@unique([tenantId, day, kind])
 @@map("briefing_reports")
}
model BriefingResolution {
 id String @id @default(cuid())
 reportId String
 report BriefingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
 actionKey String
 userId String
 note String
 createdAt DateTime @default(now())
 @@unique([reportId, actionKey])
 @@map("briefing_resolutions")
}

enum NotificationCategoria {
  SISTEMA
  PRATICHE
  RICAMBI
  CLIENTI
  PAGAMENTI
  AI
  SICUREZZA
}

// Notifica in-app personale (una riga per destinatario, anche quando lo
// stesso evento va a più utenti): così "segna come letta" riguarda solo
// chi l'ha letta, non l'evento in sé.
model Notification {
  id        String                @id @default(cuid())
  tenantId  String
  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoria NotificationCategoria
  titolo    String
  messaggio String
  link      Json?
  letta     Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([tenantId, userId, letta])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

enum GdprRichiestaTipo {
  CANCELLAZIONE_ACCOUNT
  CANCELLAZIONE_CLIENTE
  EXPORT_DATI
}

enum GdprRichiestaStato {
  IN_ATTESA
  COMPLETATA
  RIFIUTATA
}

// Registro delle richieste GDPR (cancellazione, export): non esegue mai
// da sola una cancellazione distruttiva dell'intera organizzazione — è
// una coda verificabile, in attesa di un pannello super-admin (punto 13,
// non ancora costruito) che la processi con controllo umano.
model GdprRichiesta {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo          GdprRichiestaTipo
  stato         GdprRichiestaStato  @default(IN_ATTESA)
  richiedenteId String
  richiedente   User                @relation(fields: [richiedenteId], references: [id])
  clienteId     String?
  note          String?
  createdAt     DateTime            @default(now())
  risoltoAt     DateTime?

  @@index([tenantId, stato])
  @@map("gdpr_richieste")
}

// Idempotenza webhook Stripe: l'id evento Stripe è globalmente univoco,
// quindi se un webhook viene consegnato più volte (Stripe lo fa apposta,
// "at least once delivery") il secondo tentativo trova la riga già
// presente e non riapplica l'effetto una seconda volta.
model StripeWebhookEvent {
  id          String   @id
  tipo        String
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

// Punto 31 (seed super-admin): account di livello piattaforma, mai
// legato a un tenant — gestisce Rifless stessa (elenco tenant, code
// GDPR in attesa, ecc.), non i dati di una singola carrozzeria.
// Deliberatamente un modello separato da User, non un flag su di esso:
// User è progettato per essere sempre dentro un tenant (tenantId
// obbligatorio), mescolare i due concetti avrebbe reso troppo facile
// un errore che lascia un token senza tenantId passare per le rotte
// tenant-scoped (vedi il controllo esplicito in middleware/auth.js).
model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  ultimoAccessoAt DateTime?

  @@map("super_admins")
}

// Punto 34 (contatti commerciali) e punto 35 (richiesta demo): un solo
// modello per entrambe le origini, non due tabelle parallele — sono lo
// stesso concetto (un contatto commerciale in ingresso) con un modulo
// diverso e un campo "origine" a distinguerle. Gli stati sono quelli
// esatti richiesti dal punto 35 (pipeline vendita vista dal super-admin,
// non ancora costruita — vedi punto 35), definiti già qui per evitare
// una seconda migrazione quando arriverà.
enum LeadOrigine {
  CONTATTO
  DEMO
}

enum LeadStato {
  NUOVO
  CONTATTATO
  DEMO
  TRIAL
  CLIENTE
  PERSO
}

model Lead {
  id               String      @id @default(cuid())
  nome             String
  cognome          String?
  carrozzeria      String
  email            String
  telefono         String?
  numeroDipendenti Int?
  messaggio        String?
  origine          LeadOrigine
  stato            LeadStato   @default(NUOVO)
  createdAt        DateTime    @default(now())

  @@map("leads")
}

// Punto 36 (FAQ): "Crea FAQ modificabile" — in un database, non testo
// statico nell'HTML, altrimenti ogni modifica richiederebbe un
// redeploy del codice invece che una chiamata API dal super-admin.
model FaqItem {
  id        String   @id @default(cuid())
  domanda   String
  risposta  String
  ordine    Int      @default(0)
  attiva    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faq_items")
}

// Punto 37 (supporto cliente): "contatta supporto", "segnala problema"
// e "richiedi funzione" sono la stessa entità (un ticket) con categoria
// diversa, non tre sistemi separati — coerente con come punto 34/35
// condividono Lead con un campo "origine".
enum TicketCategoria {
  SUPPORTO
  BUG
  FUNZIONALITA
}

enum TicketPriorita {
  BASSA
  MEDIA
  ALTA
  URGENTE
}

enum TicketStato {
  APERTO
  IN_LAVORAZIONE
  RISOLTO
  CHIUSO
}

model Ticket {
  id         String          @id @default(cuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id])
  categoria  TicketCategoria
  priorita   TicketPriorita  @default(MEDIA)
  messaggio  String
  stato      TicketStato     @default(APERTO)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([tenantId, stato])
  @@map("tickets")
}
