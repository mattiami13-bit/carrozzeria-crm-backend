// ---------------------------------------------------------------
// SCHEMA DATABASE — CRM Carrozzerie (multi-tenant)
//
// Strategia multi-tenant scelta: "shared database, shared schema"
// con colonna tenantId su ogni tabella + Row Level Security (RLS)
// a livello Postgres come seconda barriera oltre all'app layer.
// È la strategia più economica da operare per un SaaS con molti
// tenant piccoli/medi (una carrozzeria = poche decine di utenti),
// e scala facilmente a centinaia di tenant senza gestire N database
// separati. Se in futuro un cliente enterprise richiede isolamento
// fisico dei dati, si può migrare selettivamente quel tenant verso
// uno schema/database dedicato senza toccare il resto.
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider  = "postgresql"
  
}

// -----------------------------
// TENANCY
// -----------------------------

model Tenant {
  id             String    @id @default(cuid())
  ragioneSociale String
  partitaIva     String?   @unique
  piano          Plan      @default(TRIAL)
  trialEndsAt    DateTime?
  limiteAnalisiIAMensile Int?
  limiteAssistenteIAMensile Int?
  createdAt      DateTime  @default(now())

  delaySettings DelaySettings?
  delayPlans DelayPlan[]
  delayForecasts DelayForecast[]
  delayDecisions DelayDecision[]
  trackedParts TrackedPart[]
  partBlocks VehiclePartBlock[]
  partDocuments TrackedPartDocument[]
  profitRecords ProfitRecord[]
  profitSettings ProfitSettings?
  users          User[]
  clients        Client[]
  vehicles       Vehicle[]
  quotes         Quote[]
  appointments   Appointment[]
  parts          Part[]
  loanerCars     LoanerCar[]
  loanerBookings LoanerBooking[]
  supplierOrders SupplierOrder[]
  sinistri       Sinistro[]
  aiAnalyses  AiAnalysisLog[]
  assistantLogs AiAssistantLog[]
  portalAccesses PortalAccess[]
  damageAnalyses DamageAnalysis[]
  damageItems    DamageItem[]
  insuranceGapAnalyses   InsuranceGapAnalysis[]
  insuranceGapItems      InsuranceGapItem[]
  insuranceGapSuggestions InsuranceGapSuggestion[]





  @@map("tenants")
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// -----------------------------
// UTENTI / RUOLI
// -----------------------------

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  nome         String
  cognome      String
  email        String   @unique
  passwordHash String
  ruolo        Role     @default(TECNICO)
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  vehiclesAssegnati   Vehicle[]      @relation("TecnicoAssegnato")
  stageChanges        StageHistory[]
  timeEntries         TimeEntry[]
  auditLogs         AuditLog[]
  appuntamentiTecnico Appointment[]  @relation("TecnicoAppuntamento")
  analisiDanniCreate  DamageAnalysis[]
  correzioniDanni     DamageItem[]
  analisiGapCreate         InsuranceGapAnalysis[]
  correzioniGapAssicurazione InsuranceGapItem[]

  @@index([tenantId])
  @@map("users")
}

enum Role {
  ADMIN
  ACCETTATORE
  TECNICO
  AMMINISTRAZIONE
}

// -----------------------------
// CLIENTI
// -----------------------------

model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  nome          String
  cognome       String
  telefono      String?
  email         String?
  codiceFiscale String?
  partitaIva    String?
  indirizzo     String?
  noteInterne   String?
  createdAt     DateTime @default(now())

  vehicles     Vehicle[]
  quotes       Quote[]
  documents    Document[]
  appointments Appointment[]
  sinistri     Sinistro[]
  loanerBookings LoanerBooking[]

  @@index([tenantId])
  @@index([tenantId, telefono])
  @@map("clients")
}

// -----------------------------
// VEICOLI + WORKFLOW
// -----------------------------

model Vehicle {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  appointments Appointment[]
  sinistri     Sinistro[]
  portalAccesses PortalAccess[]

  marca   String
  modello String
  targa   String
  vin     String?
  colore  String?
  km      Int?

  compagniaAssicurativa String?
  numeroSinistro        String?
  perito                String?

  stage     WorkflowStage @default(ACCETTAZIONE)
  tecnicoId String?
  tecnico   User?         @relation("TecnicoAssegnato", fields: [tecnicoId], references: [id])

  dataIngresso          DateTime  @default(now())
  dataPrevistaConsegna  DateTime?
  dataConsegnaEffettiva DateTime?
  firmaConsegnaDataUrl String?   @db.Text
  firmatarioConsegna   String?
  dataFirmaConsegna    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stimaIA     Json?
  stimaIAAt   DateTime?

  delayPlan DelayPlan?
  delayForecasts DelayForecast[]
  delayDecisions DelayDecision[]
  trackedParts TrackedPart[]
  partBlocks VehiclePartBlock[]
  profitRecord ProfitRecord?
  photos       Photo[]
  quotes       Quote[]
  stageHistory StageHistory[]
  damageAnalyses DamageAnalysis[]
  insuranceGapAnalyses InsuranceGapAnalysis[]
  loanerBookings LoanerBooking[]

  @@index([tenantId])
  @@index([tenantId, targa])
  @@index([tenantId, stage])
  @@map("vehicles")
}

enum WorkflowStage {
  ACCETTAZIONE
  PREVENTIVO
  ATTESA_APPROVAZIONE
  ORDINE_RICAMBI
  IN_LAVORAZIONE
  PREPARAZIONE
  VERNICIATURA
  LUCIDATURA
  CONTROLLO_QUALITA
  LAVAGGIO
  PRONTA_CONSEGNA
  CONSEGNATA
}

// Log immutabile di ogni cambio stato: alimenta i KPI (tempo medio
// per stadio, tempo fermo auto, produttività tecnico) e la timeline
// mostrata al cliente nel portale.
model StageHistory {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  fromStage WorkflowStage?
  toStage   WorkflowStage

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id])

  changedAt DateTime @default(now())

  @@index([vehicleId])
  @@map("stage_history")
}

// -----------------------------
// FOTOGRAFIE
// -----------------------------

model Photo {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  fase      FasePhoto
  url       String // path su object storage (S3-compatibile)
  createdAt DateTime  @default(now())

  timeline Json @default("{}")
  timelineVersion Int @default(1)
  timelineEdits PhotoTimelineEdit[]

  @@index([vehicleId])
  @@map("photos")
}

enum FasePhoto {
  PRIMA
  DURANTE
  DOPO
}

// -----------------------------
// PREVENTIVI
// -----------------------------

model Quote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  stato       QuoteStatus @default(BOZZA)
  imponibile  Decimal     @db.Decimal(10, 2)
  aliquotaIva Decimal     @default(22.00) @db.Decimal(4, 2)
  totale      Decimal     @db.Decimal(10, 2)

  pdfUrl    String?
  inviatoAt DateTime?
  firmaDataUrl    String?   @db.Text
  firmatarioNome  String?
  firmatoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]
  damageItems DamageItem[]
  insuranceGapAnalyses InsuranceGapAnalysis[]

  @@index([tenantId])
  @@index([tenantId, stato])
  @@map("quotes")
}

enum QuoteStatus {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  tipo           QuoteItemType
  descrizione    String
  quantita       Decimal       @default(1) @db.Decimal(10, 2)
  prezzoUnitario Decimal       @db.Decimal(10, 2)

  insuranceGapItems InsuranceGapItem[]

  @@map("quote_items")
}

enum QuoteItemType {
  MANODOPERA
  RICAMBIO
  VERNICE
  ALTRO
}

// -----------------------------
// AI DAMAGE ASSISTANT
// -----------------------------
// Modulo nuovo e separato dalla vecchia "Stima danni IA" (Vehicle.stimaIA,
// vedi POST /api/vehicles/:id/analizza-danni): quella resta invariata e
// continua a funzionare com'è. Questo modulo è più strutturato — un danno
// per riga invece di una stima unica testuale — pensato per generare voci
// di preventivo riga per riga, sempre con conferma umana obbligatoria.

// Una "sessione" di analisi: un gruppo di foto mandate insieme all'IA, che
// genera N DamageItem (uno per ogni danno individuato separatamente).
model DamageAnalysis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  creatoDaId String?
  creatoDa   User?   @relation(fields: [creatoDaId], references: [id])

  photoIds       Json // array di Photo.id analizzati in questa sessione
  rispostaGrezza Json? // risposta testuale grezza dell'IA: debug e miglioramento futuro del prompt

  createdAt DateTime @default(now())

  items DamageItem[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("damage_analyses")
}

// Un singolo danno individuato dall'IA. I campi "*AI" sono il risultato
// originale del modello e non vengono mai sovrascritti: restano come
// confronto con i campi correnti (modificabili dall'operatore) per capire
// dove l'IA sbaglia più spesso — base per migliorare il prompt in futuro.
model DamageItem {
  id               String         @id @default(cuid())
  damageAnalysisId String
  damageAnalysis   DamageAnalysis @relation(fields: [damageAnalysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Valori originali suggeriti dall'IA — immutabili.
  parteAI                 String
  posizioneAI             String?
  tipologiaDannoAI        String
  gravitaAI               DamageSeverity
  lavorazioneAI           String?
  necessitaSostituzioneAI Boolean @default(false)
  confidenzaPercento      Int? // 0-100: quanto l'IA è sicura di questo rilevamento
  vociPreventivoAI        Json // voci suggerite: array di {tipo, descrizione, quantita, prezzoUnitario}

  // Valori correnti: partono identici a quelli AI, l'operatore li corregge liberamente.
  parte                 String
  posizione             String?
  tipologiaDanno        String
  gravita               DamageSeverity
  lavorazioneSuggerita  String?
  necessitaSostituzione Boolean @default(false)
  vociPreventivo        Json
  noteOperatore         String?

  modificatoManualmente Boolean   @default(false)
  modificatoDaId        String?
  modificatoDa          User?     @relation(fields: [modificatoDaId], references: [id])
  modificatoAt          DateTime?

  // Preventivo bozza in cui questo danno è stato eventualmente incluso.
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([damageAnalysisId])
  @@map("damage_items")
}

enum DamageSeverity {
  LIEVE
  MEDIA
  GRAVE
}

// -----------------------------
// INSURANCE GAP ANALYSIS
// -----------------------------
// Confronto tra il preventivo interno e il documento (perizia/preventivo)
// ricevuto dall'assicurazione. Sola lettura/proposta: l'IA classifica ogni
// voce del preventivo interno come corrispondente, con differenza o
// mancante nel documento assicurazione, e suggerisce elementi da
// verificare — non dichiara mai automaticamente una voce dovuta o corretta.
// Riservato a ADMIN/AMMINISTRAZIONE (confronto importi/prezzi).

model InsuranceGapAnalysis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  sinistroId String?
  sinistro   Sinistro? @relation(fields: [sinistroId], references: [id])

  documentName    String
  documentMime    String
  documentSize    Int
  documentContent Bytes

  rispostaGrezza Json? // risposta testuale grezza dell'IA: debug e miglioramento futuro del prompt

  totalePreventivoInterno         Decimal  @db.Decimal(10, 2)
  totaleRiconosciutoAssicurazione Decimal? @db.Decimal(10, 2)
  differenza                      Decimal? @db.Decimal(10, 2)

  creatoDaId String?
  creatoDa   User?   @relation(fields: [creatoDaId], references: [id])
  createdAt  DateTime @default(now())

  items        InsuranceGapItem[]
  suggerimenti InsuranceGapSuggestion[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("insurance_gap_analyses")
}

// Una riga per ciascuna voce del preventivo interno selezionato: i campi
// "*AI" sono la lettura originale del documento assicurazione fatta
// dal modello e restano immutabili; l'operatore corregge solo i campi
// correnti (utile per capire dove l'IA legge male i documenti).
model InsuranceGapItem {
  id         String                @id @default(cuid())
  analysisId String
  analysis   InsuranceGapAnalysis  @relation(fields: [analysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id])

  // Snapshot della voce del preventivo interno al momento dell'analisi.
  descrizione    String
  tipo           QuoteItemType
  quantita       Decimal @db.Decimal(10, 2)
  prezzoUnitario Decimal @db.Decimal(10, 2)

  // Lettura originale del documento assicurazione fatta dall'IA — immutabile.
  trovatoAI                      Boolean @default(false)
  descrizioneAssicurazioneAI     String?
  quantitaAssicurazioneAI        Decimal? @db.Decimal(10, 2)
  prezzoUnitarioAssicurazioneAI  Decimal? @db.Decimal(10, 2)
  statoAI                        InsuranceGapStatus

  // Valori correnti: partono identici a quelli AI, l'operatore li corregge liberamente.
  quantitaAssicurazione       Decimal? @db.Decimal(10, 2)
  prezzoUnitarioAssicurazione Decimal? @db.Decimal(10, 2)
  stato                       InsuranceGapStatus
  noteOperatore               String?

  modificatoManualmente Boolean   @default(false)
  modificatoDaId        String?
  modificatoDa          User?     @relation(fields: [modificatoDaId], references: [id])
  modificatoAt          DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([analysisId])
  @@map("insurance_gap_items")
}

enum InsuranceGapStatus {
  CORRISPONDE
  DIFFERENZA
  MANCANTE
}

// Possibili elementi dimenticati suggeriti dall'IA, mai legati a una voce
// specifica del preventivo: solo un promemoria da verificare professionalmente.
model InsuranceGapSuggestion {
  id         String               @id @default(cuid())
  analysisId String
  analysis   InsuranceGapAnalysis @relation(fields: [analysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  voce     String
  motivo   String
  scartata Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([analysisId])
  @@map("insurance_gap_suggestions")
}

// -----------------------------
// MAGAZZINO RICAMBI
// -----------------------------

model Part {
 trackedParts TrackedPart[]
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  codice         String
  descrizione    String
  giacenza       Int      @default(0)
  scortaMinima   Int      @default(0)
  prezzoAcquisto Decimal  @db.Decimal(10, 2)
  prezzoVendita  Decimal? @db.Decimal(10, 2)
  fornitore      String?

  movements PartMovement[]

  @@unique([tenantId, codice])
  @@index([tenantId])
  @@map("parts")
}

model PartMovement {
  id     String @id @default(cuid())
  partId String
  part   Part   @relation(fields: [partId], references: [id])

  tipo      MovementType
  quantita  Int
  createdAt DateTime     @default(now())

  @@map("part_movements")
}

enum MovementType {
  CARICO
  SCARICO
}

// -----------------------------
// ORDINI FORNITORI
// -----------------------------

model SupplierOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fornitore            String
  stato                OrderStatus @default(IN_ATTESA)
  dataOrdine           DateTime    @default(now())
  dataConsegnaPrevista DateTime?
  note                 String?

  items SupplierOrderItem[]

  @@index([tenantId])
  @@map("supplier_orders")
}

model SupplierOrderItem {
 trackedPart TrackedPart?
  id              String        @id @default(cuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id])

  // partId non è collegato con una relation esplicita a Part (come già
  // fatto per LoanerBooking.clientId): la voce d'ordine deve poter
  // esistere anche per ricambi non ancora presenti a magazzino.
  partId           String?
  descrizione      String
  quantitaOrdinata Int
  quantitaRicevuta Int      @default(0)
  prezzoUnitario   Decimal? @db.Decimal(10, 2)

  @@map("supplier_order_items")
}

enum OrderStatus {
  IN_ATTESA
  PARZIALE
  CONSEGNATO
}

// -----------------------------
// AUTO SOSTITUTIVE
// -----------------------------

enum LoanerStatus {
  DISPONIBILE
  PRENOTATA
  ASSEGNATA
  MANUTENZIONE
  NON_DISPONIBILE
}

enum FuelType {
  BENZINA
  DIESEL
  GPL
  METANO
  ELETTRICO
  IBRIDA
}

enum LoanerBookingStatus {
  PRENOTATA
  ASSEGNATA
  RESTITUITA
  ANNULLATA
}

model LoanerCar {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  targa      String
  marca      String
  modello    String
  km         Int?
  carburante FuelType?

  stato LoanerStatus @default(DISPONIBILE)

  // Scadenze documenti/interventi: alimentano gli alert della flotta.
  assicurazioneCompagnia String?
  assicurazioneScadenza  DateTime?
  revisioneScadenza      DateTime?
  manutenzioneNote       String?
  manutenzioneScadenza   DateTime?
  manutenzioneKm         Int? // prossima manutenzione programmata a questo chilometraggio

  // Costo interno giornaliero (in centesimi) usato per calcolare il costo
  // di ogni assegnazione e attribuirlo alla pratica nel Profit Tracker.
  costoGiornalieroCents Int @default(0)

  note   String?
  foto   Json    @default("[]") // array di {url, caption}
  attiva Boolean @default(true) // dismissione flotta (soft delete logico)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings LoanerBooking[]

  @@index([tenantId])
  @@index([tenantId, stato])
  @@map("loaner_cars")
}

model LoanerBooking {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  loanerCarId String
  loanerCar   LoanerCar @relation(fields: [loanerCarId], references: [id])

  // Cliente e pratica (veicolo del cliente) collegati all'assegnazione.
  clientId String?
  client   Client?  @relation(fields: [clientId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  stato LoanerBookingStatus @default(PRENOTATA)

  // Finestra di prenotazione / utilizzo.
  dataInizio       DateTime // inizio prenotazione o consegna prevista
  dataFinePrevista DateTime?
  dataConsegna     DateTime? // consegna effettiva al cliente
  dataRestituzione DateTime? // rientro effettivo

  kmIniziali         Int?
  kmFinali           Int?
  carburanteIniziale Int? // livello 0-100%
  carburanteFinale   Int?

  firmaClienteDataUrl String?   @db.Text
  firmatarioNome      String?
  firmaAt             DateTime?

  fotoConsegna     Json    @default("[]") // array di {url, caption}
  fotoRestituzione Json    @default("[]")
  danni            Json    @default("[]") // array di {descrizione, gravita, note}
  note             String?

  // Snapshot del costo/giorno al momento dell'assegnazione + totale calcolato
  // al rientro. attribuitaAllaPratica abilita l'inserimento del costo nel
  // Profit Tracker della pratica collegata.
  costoGiornalieroCents  Int     @default(0)
  costoTotaleCents       Int?
  attribuitaAllaPratica  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([loanerCarId])
  @@index([tenantId, vehicleId])
  @@map("loaner_bookings")
}

// -----------------------------
// CALENDARIO / APPUNTAMENTI
// -----------------------------

model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  titolo    String
  inizio    DateTime
  fine      DateTime
  note      String?
  tipo      String?
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  tecnicoId String?
  tecnico   User?    @relation("TecnicoAppuntamento", fields: [tecnicoId], references: [id])

  @@index([tenantId])
  @@map("appointments")
}

// -----------------------------
// DOCUMENTI / ORE LAVORATE
// -----------------------------

model Document {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  nome      String
  url       String
  createdAt DateTime @default(now())

  @@map("documents")
}

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  inizio DateTime
  fine   DateTime?

  @@map("time_entries")
}

// ------------------------
// SINISTRI
// ------------------------

model Sinistro {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  numeroPratica         String?
  compagniaAssicurativa String
  perito                String?
  responsabile          String? // chi segue la pratica in carrozzeria (titolare, admin, ecc.)

  stato SinistroStatus @default(APERTO)

  importoTotale              Decimal? @db.Decimal(10, 2)
  percentualeFranchigia      Decimal? @db.Decimal(5, 2)
  importoFranchigia          Decimal? @db.Decimal(10, 2)
  importoPagatoAssicurazione Decimal  @default(0) @db.Decimal(10, 2)
  importoPagatoCliente       Decimal  @default(0) @db.Decimal(10, 2)

  dataApertura  DateTime  @default(now())
  dataChiusura  DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insuranceGapAnalyses InsuranceGapAnalysis[]

  @@index([tenantId])
  @@index([tenantId, stato])
  @@map("sinistri")
}

enum SinistroStatus {
  APERTO
  INVIATO_ASSICURAZIONE
  PERIZIA_FISSATA
  PERIZIA_COMPLETATA
  APPROVATO
  LAVORAZIONE
  COMPLETATO
  LIQUIDATO
}

// -----------------------------
// PORTALE CLIENTE
// -----------------------------

// Un link di accesso pubblico per il cliente, associato a UN SOLO
// veicolo/pratica (mai a un cliente intero: evita che vedendo un link
// si possa risalire ad altri veicoli/dati dello stesso cliente).
// Il token è la sola chiave d'accesso: nessuna password, nessun login.
model PortalAccess {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  token String @unique

  attivo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  ultimoAccessoAt DateTime?

  @@index([tenantId])
  @@index([token])
  @@map("portal_access")
}

// -----------------------------
// UTILIZZO IA (quote/abbonamento)
// -----------------------------

// Log immutabile di ogni analisi IA completata con successo: alimenta il
// conteggio mensile usato per applicare i limiti del piano di abbonamento.
model AiAnalysisLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  vehicleId String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_analysis_logs")
}

// Log di ogni domanda fatta all'assistente conversazionale: alimenta il
// conteggio mensile usato per applicare i limiti del piano di abbonamento.
// "domanda" è salvata solo per un eventuale controllo/debug futuro.
model AiAssistantLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  domanda   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_assistant_logs")
}

// Registro attività: chi ha fatto cosa e quando. Scritto automaticamente
// da un middleware globale (vedi audit.js) per ogni azione che modifica
// dati e per ogni tentativo respinto per permessi insufficienti.
// tenantId/userId sono nullable perché un tentativo con token mancante o
// non valido non ha un utente/tenant associato, ma vogliamo comunque
// tracciare il tentativo.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  metodo     String
  percorso   String
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Profit Tracker: amounts in integer euro cents inside a versioned, validated ledger.
model ProfitRecord {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  vehicleId String @unique
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  data Json
  version Int @default(1)
  updatedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
  @@map("profit_records")
}

model ProfitSettings {
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id])
  criticalBelow Int @default(20)
  goodFrom Int @default(35)
  @@map("profit_settings")
}

// Predictive Delay AI: operational data only; no quote prices exposed.
model DelaySettings {
 tenantId String @id
 tenant Tenant @relation(fields: [tenantId], references: [id])
 data Json
 version Int @default(1)
 updatedAt DateTime @updatedAt
 @@map("delay_settings")
}
model DelayPlan {
 vehicleId String @id
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 data Json
 version Int @default(1)
 updatedById String
 updatedAt DateTime @updatedAt
 @@index([tenantId])
 @@map("delay_plans")
}
model DelayForecast {
 id String @id @default(cuid())
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 fingerprint String
 modelVersion String
 promisedAt DateTime?
 estimatedDate String?
 risk Int?
 input Json
 result Json
 actualDeliveredAt DateTime?
 createdAt DateTime @default(now())
 decisions DelayDecision[]
 @@unique([vehicleId, fingerprint])
 @@index([tenantId, createdAt])
 @@index([vehicleId, createdAt])
 @@map("delay_forecasts")
}
model DelayDecision {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 forecastId String
 forecast DelayForecast @relation(fields: [forecastId], references: [id])
 action String
 proposedDate String?
 note String
 userId String
 createdAt DateTime @default(now())
 @@index([tenantId, vehicleId, createdAt])
 @@map("delay_decisions")
}

// Parts Tracking: one operational record per practice/vehicle and ordered line.
model TrackedPart {
 id String @id @default(cuid())
 requestKey String @unique
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 orderItemId String? @unique
 orderItem SupplierOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
 catalogPartId String?
 catalogPart Part? @relation(fields: [catalogPartId], references: [id], onDelete: SetNull, onUpdate: NoAction)
 status String @default("DA_ORDINARE")
 data Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events TrackedPartEvent[]
 documents TrackedPartDocument[]
 @@index([tenantId, vehicleId])
 @@map("tracked_parts")
}
model TrackedPartEvent {
 id String @id @default(cuid())
 partId String
 part TrackedPart @relation(fields: [partId], references: [id])
 actorId String?
 fromStatus String?
 toStatus String
 reason String
 snapshot Json
 createdAt DateTime @default(now())
 @@index([partId, createdAt])
 @@map("tracked_part_events")
}
model VehiclePartBlock {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 startedAt DateTime @default(now())
 endedAt DateTime?
 @@index([tenantId, vehicleId])
 @@map("vehicle_part_blocks")
}
model TrackedPartDocument {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 partId String
 part TrackedPart @relation(fields: [partId], references: [id])
 name String
 mime String
 size Int
 content Bytes
 createdAt DateTime @default(now())
 @@index([tenantId, partId])
 @@map("tracked_part_documents")
}

model PhotoTimelineEdit {
 id String @id @default(cuid())
 photoId String
 photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
 actorId String
 before Json
 after Json
 createdAt DateTime @default(now())
 @@index([photoId, createdAt])
 @@map("photo_timeline_edits")
}
