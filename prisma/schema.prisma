// -----------------------------
// PORTALE CLIENTE
// -----------------------------

// Un link di accesso pubblico per il cliente, associato a UN SOLO
// veicolo/pratica (mai a un cliente intero: evita che vedendo un link
// si possa risalire ad altri veicoli/dati dello stesso cliente).
// Il token è la sola chiave d'accesso: nessuna password, nessun login.
model PortalAccess {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  token String @unique

  attivo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  // Token temporaneo: scade di default 180 giorni dopo la creazione.
  // Un link scaduto o disattivato risponde come "non trovato", mai con
  // un errore che distingua i due casi (non deve rivelare se un token è
  // mai esistito).
  scadenza        DateTime?
  ultimoAccessoAt DateTime?
  numeroAccessi   Int       @default(0)

  azioni PortalAction[]

  @@index([tenantId])
  @@index([token])
  @@map("portal_access")
}

enum PortalActionTipo {
  APPROVAZIONE_PREVENTIVO
  APPROVAZIONE_INTEGRAZIONE
  FIRMA_DOCUMENTO
  RICHIESTA_CONTATTO
  RICHIESTA_RITIRO
}

// Audit log di ogni azione del cliente nel portale (approvazioni, firme,
// richieste): traccia sempre timestamp, IP e, per le richieste allo staff
// (contatto/ritiro), lo stato di gestione.
model PortalAction {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  portalAccessId String
  portalAccess   PortalAccess @relation(fields: [portalAccessId], references: [id])

  tipo         PortalActionTipo
  messaggio    String?   @db.Text
  dataRichiesta DateTime?
  ip           String?

  gestita     Boolean   @default(false)
  gestitaDaId String?
  gestitaDa   User?     @relation(fields: [gestitaDaId], references: [id])
  gestitaAt   DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([vehicleId])
  @@map("portal_actions")
}

// Documenti condivisi con il cliente tramite il portale (es. condizioni,
// informativa, dichiarazioni): byte salvati su Postgres e mai esposti con
// un URL pubblico, esattamente come i documenti di Parts Tracking e i
// documenti assicurazione di Insurance Gap Analysis.
// -----------------------------
// MODALITÀ TECNICO: lavorazioni e tracciamento ore
// -----------------------------
// Reparto: stessi 4 valori usati (in minuscolo, dentro un JSON) dal
// Predictive Delay AI (src/lib/delay.js DEPARTMENTS) — qui come enum
// Prisma nativo per le lavorazioni assegnate ai tecnici.
enum Reparto {
  CARROZZERIA
  MECCANICA
  VERNICIATURA
  FINITURA
}

enum PrioritaLavorazione {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

enum WorkOrderStato {
  DA_INIZIARE
  IN_CORSO
  IN_PAUSA
  COMPLETATA
}

enum WorkOrderEventoTipo {
  CREATA
  INIZIATA
  PAUSA
  RIPRESA
  TERMINATA
  CORREZIONE_MANUALE
  RIASSEGNATA
}

// Una lavorazione assegnata a un tecnico su una pratica ("I miei lavori").
// Le ore reali non sono un campo diretto: si calcolano sempre sommando i
// segmenti in WorkOrderTimeEntry, così pausa/ripresa/correzioni restano
// sempre coerenti con lo storico invece che con un totale scollegato.
model WorkOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  tecnicoId String
  tecnico   User   @relation("WorkOrderTecnico", fields: [tecnicoId], references: [id])

  titolo        String
  reparto       Reparto
  priorita      PrioritaLavorazione @default(NORMALE)
  oreStimate    Decimal             @db.Decimal(6, 2)
  noteTecniche  String?             @db.Text
  dataConsegna  DateTime?

  stato WorkOrderStato @default(DA_INIZIARE)

  creatoDaId String?
  creatoDa   User?   @relation("WorkOrderCreatore", fields: [creatoDaId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timeEntries WorkOrderTimeEntry[]
  eventi      WorkOrderEvento[]

  @@index([tenantId])
  @@index([tenantId, tecnicoId])
  @@index([vehicleId])
  @@map("work_orders")
}

// Segmenti di lavoro effettivo: un intervallo per ogni INIZIA→PAUSA/TERMINA.
// Le ore reali di una lavorazione sono sempre la somma di questi segmenti,
// mai un totale inserito a mano (le correzioni manuali modificano un
// segmento esistente, con motivo obbligatorio e tracciate in WorkOrderEvento).
model WorkOrderTimeEntry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  tecnicoId   String
  tecnico     User      @relation("WorkOrderTimeEntryTecnico", fields: [tecnicoId], references: [id])

  inizio DateTime
  fine   DateTime?

  correzioneManuale Boolean   @default(false)
  correzioneMotivo  String?   @db.Text
  correzioneDaId    String?
  correzioneDa      User?     @relation("WorkOrderTimeEntryCorrettore", fields: [correzioneDaId], references: [id])
  correzioneAt      DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([workOrderId])
  @@index([tecnicoId])
  @@map("work_order_time_entries")
}

// Storico modifiche immutabile: ogni cambio di stato e ogni correzione
// manuale, chi l'ha fatto e quando.
model WorkOrderEvento {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  tipo     WorkOrderEventoTipo
  daStato  WorkOrderStato?
  aStato   WorkOrderStato?
  dettagli Json?

  attoreId String?
  attore   User?   @relation("WorkOrderEventoAttore", fields: [attoreId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_eventi")
}

model PortalDocument {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  nome    String
  mime    String
  size    Int
  content Bytes

  richiedeFirma  Boolean   @default(false)
  firmaDataUrl   String?   @db.Text
  firmatarioNome String?
  firmatoAt      DateTime?

  caricatoDaId String?
  caricatoDa   User?   @relation(fields: [caricatoDaId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([vehicleId])
  @@map("portal_documents")
}

// -----------------------------
// UTILIZZO IA (quote/abbonamento)
// -----------------------------

// Log immutabile di ogni analisi IA completata con successo: alimenta il
// conteggio mensile usato per applicare i limiti del piano di abbonamento.
model AiAnalysisLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  vehicleId String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_analysis_logs")
}

// Log di ogni domanda fatta all'assistente conversazionale: alimenta il
// conteggio mensile usato per applicare i limiti del piano di abbonamento.
// "domanda" è salvata solo per un eventuale controllo/debug futuro.
model AiAssistantLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  domanda   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_assistant_logs")
}

// Registro attività: chi ha fatto cosa e quando. Scritto automaticamente
// da un middleware globale (vedi audit.js) per ogni azione che modifica
// dati e per ogni tentativo respinto per permessi insufficienti.
// tenantId/userId sono nullable perché un tentativo con token mancante o
// non valido non ha un utente/tenant associato, ma vogliamo comunque
// tracciare il tentativo.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  metodo     String
  percorso   String
  statusCode Int

  // Punto 21 del prompt SaaS: oltre al log HTTP generico sopra, un'etichetta
  // semantica leggibile ("login", "password modificata", "piano cambiato"...)
  // per le azioni rilevanti, l'id della risorsa toccata quando deducibile
  // dall'URL, l'IP del chiamante, e metadata essenziali — MAI password,
  // token, dati di pagamento o altri segreti (vedi audit.js: solo un
  // elenco esplicito di campi sicuri viene scritto qui, mai req.body intero).
  azione     String?
  risorsaId  String?
  ip         String?
  metadata   Json?

  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, azione, createdAt])
  @@map("audit_logs")
}

// Profit Tracker: amounts in integer euro cents inside a versioned, validated ledger.
model ProfitRecord {
