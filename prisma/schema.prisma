// Parts Tracking: one operational record per practice/vehicle and ordered line.
model TrackedPart {
 id String @id @default(cuid())
 requestKey String @unique
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 orderItemId String? @unique
 orderItem SupplierOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
 catalogPartId String?
 catalogPart Part? @relation(fields: [catalogPartId], references: [id], onDelete: SetNull, onUpdate: NoAction)
 status String @default("DA_ORDINARE")
 data Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events TrackedPartEvent[]
 documents TrackedPartDocument[]
 @@index([tenantId, vehicleId])
