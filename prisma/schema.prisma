// ---------------------------------------------------------------
// SCHEMA DATABASE — CRM Carrozzerie (multi-tenant)
//
// Strategia multi-tenant scelta: "shared database, shared schema"
// con colonna tenantId su ogni tabella + Row Level Security (RLS)
// a livello Postgres come seconda barriera oltre all'app layer.
// È la strategia più economica da operare per un SaaS con molti
// tenant piccoli/medi (una carrozzeria = poche decine di utenti),
// e scala facilmente a centinaia di tenant senza gestire N database
// separati. Se in futuro un cliente enterprise richiede isolamento
// fisico dei dati, si può migrare selettivamente quel tenant verso
// uno schema/database dedicato senza toccare il resto.
// ---------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "ts"
}

datasource db {
  provider  = "postgresql"
  
}

// -----------------------------
// TENANCY
// -----------------------------

model Tenant {
  id             String    @id @default(cuid())
  ragioneSociale String
  partitaIva     String?   @unique
  piano          Plan      @default(TRIAL)
  trialEndsAt    DateTime?
  limiteAnalisiIAMensile Int?
  limiteAssistenteIAMensile Int?
  // Modalità Tecnico: di default un tecnico non può avere due lavorazioni
  // IN_CORSO insieme (evita di sommare per errore ore su due pratiche);
  // l'admin può abilitarlo esplicitamente per i casi in cui serve davvero.
  consentiLavorazioniSimultanee Boolean @default(false)
  createdAt      DateTime  @default(now())

  delaySettings DelaySettings?
  delayPlans DelayPlan[]
  delayForecasts DelayForecast[]
  delayDecisions DelayDecision[]
  trackedParts TrackedPart[]
  partBlocks VehiclePartBlock[]
  partDocuments TrackedPartDocument[]
  profitRecords ProfitRecord[]
  profitSettings ProfitSettings?
  users          User[]
  clients        Client[]
  vehicles       Vehicle[]
  quotes         Quote[]
  appointments   Appointment[]
  parts          Part[]
  loanerCars     LoanerCar[]
  supplierOrders SupplierOrder[]
  sinistri       Sinistro[]
  aiAnalyses  AiAnalysisLog[]
  assistantLogs AiAssistantLog[]
  portalAccesses PortalAccess[]
  damageAnalyses DamageAnalysis[]
  damageItems    DamageItem[]
  insuranceGapAnalyses   InsuranceGapAnalysis[]
  insuranceGapItems      InsuranceGapItem[]
  insuranceGapSuggestions InsuranceGapSuggestion[]
  whatsappTemplates WhatsappTemplate[]
  whatsappMessages  WhatsappMessage[]
  portalActions     PortalAction[]
  portalDocuments   PortalDocument[]
  workOrders        WorkOrder[]
  workOrderTimeEntries WorkOrderTimeEntry[]
  workOrderEventi   WorkOrderEvento[]
  qcChecklistItems  QcChecklistItem[]
  qcInspections     QcInspection[]
  qcCheckResults    QcCheckResult[]
  qcNonConformita   QcNonConformita[]
  qcEventi          QcEvento[]


  @@map("tenants")
}

enum Plan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// -----------------------------
// UTENTI / RUOLI
// -----------------------------

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  nome         String
  cognome      String
  email        String   @unique
  passwordHash String
  ruolo        Role     @default(TECNICO)
  attivo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  vehiclesAssegnati   Vehicle[]      @relation("TecnicoAssegnato")
  stageChanges        StageHistory[]
  timeEntries         TimeEntry[]
  auditLogs         AuditLog[]
  appuntamentiTecnico Appointment[]  @relation("TecnicoAppuntamento")
  analisiDanniCreate  DamageAnalysis[]
  correzioniDanni     DamageItem[]
  analisiGapCreate         InsuranceGapAnalysis[]
  correzioniGapAssicurazione InsuranceGapItem[]
  whatsappTemplateAggiornati WhatsappTemplate[]
  whatsappMessaggiInviati    WhatsappMessage[]
  portalActionsGestite       PortalAction[]
  portalDocumentiCaricati    PortalDocument[]
  workOrdersAssegnati        WorkOrder[]            @relation("WorkOrderTecnico")
  workOrdersCreati           WorkOrder[]            @relation("WorkOrderCreatore")
  workOrderTimeEntries       WorkOrderTimeEntry[]   @relation("WorkOrderTimeEntryTecnico")
  workOrderTimeCorrezioni    WorkOrderTimeEntry[]   @relation("WorkOrderTimeEntryCorrettore")
  workOrderEventiAttore      WorkOrderEvento[]      @relation("WorkOrderEventoAttore")
  qcIspezioniIniziate        QcInspection[]         @relation("QcInspectionIniziataDa")
  qcIspezioniApprovate       QcInspection[]         @relation("QcInspectionApprovataDa")
  qcEsitiAggiornati          QcCheckResult[]
  qcNonConformitaResponsabile QcNonConformita[]      @relation("QcNonConformitaResponsabile")
  qcNonConformitaCreate      QcNonConformita[]       @relation("QcNonConformitaCreata")
  qcEventiAttore             QcEvento[]              @relation("QcEventoAttore")

  @@index([tenantId])
  @@map("users")
}

enum Role {
  ADMIN
  ACCETTATORE
  TECNICO
  AMMINISTRAZIONE
}

// -----------------------------
// CLIENTI
// -----------------------------

model Client {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  nome          String
  cognome       String
  telefono      String?
  email         String?
  codiceFiscale String?
  partitaIva    String?
  indirizzo     String?
  noteInterne   String?
  createdAt     DateTime @default(now())

  // Consenso privacy per le comunicazioni automatiche WhatsApp: nessun
  // messaggio viene mai inviato senza notificheWhatsappConsenso = true.
  // notificheWhatsappAttive permette di sospendere le notifiche per questo
  // cliente anche a consenso già dato (es. su sua richiesta esplicita),
  // senza dover revocare il consenso stesso.
  notificheWhatsappConsenso   Boolean   @default(false)
  notificheWhatsappConsensoAt DateTime?
  notificheWhatsappAttive     Boolean   @default(true)

  vehicles     Vehicle[]
  quotes       Quote[]
  documents    Document[]
  appointments Appointment[]
  sinistri     Sinistro[]
  whatsappMessages WhatsappMessage[]

  @@index([tenantId])
  @@index([tenantId, telefono])
  @@map("clients")
}

// -----------------------------
// VEICOLI + WORKFLOW
// -----------------------------

model Vehicle {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  appointments Appointment[]
  sinistri     Sinistro[]
  portalAccesses PortalAccess[]

  marca   String
  modello String
  targa   String
  vin     String?
  colore  String?
  km      Int?

  compagniaAssicurativa String?
  numeroSinistro        String?
  perito                String?

  stage     WorkflowStage @default(ACCETTAZIONE)
  tecnicoId String?
  tecnico   User?         @relation("TecnicoAssegnato", fields: [tecnicoId], references: [id])

  dataIngresso          DateTime  @default(now())
  dataPrevistaConsegna  DateTime?
  dataConsegnaEffettiva DateTime?
  firmaConsegnaDataUrl String?   @db.Text
  firmatarioConsegna   String?
  dataFirmaConsegna    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stimaIA     Json?
  stimaIAAt   DateTime?

  delayPlan DelayPlan?
  delayForecasts DelayForecast[]
  delayDecisions DelayDecision[]
  trackedParts TrackedPart[]
  partBlocks VehiclePartBlock[]
  profitRecord ProfitRecord?
  photos       Photo[]
  quotes       Quote[]
  stageHistory StageHistory[]
  damageAnalyses DamageAnalysis[]
  insuranceGapAnalyses InsuranceGapAnalysis[]
  whatsappMessages WhatsappMessage[]
  portalActions PortalAction[]
  portalDocuments PortalDocument[]
  workOrders WorkOrder[]
  qcInspections QcInspection[]

  @@index([tenantId])
  @@index([tenantId, targa])
  @@index([tenantId, stage])
  @@map("vehicles")
}

enum WorkflowStage {
  ACCETTAZIONE
  PREVENTIVO
  ATTESA_APPROVAZIONE
  ORDINE_RICAMBI
  IN_LAVORAZIONE
  PREPARAZIONE
  VERNICIATURA
  LUCIDATURA
  CONTROLLO_QUALITA
  LAVAGGIO
  PRONTA_CONSEGNA
  CONSEGNATA
}

// Log immutabile di ogni cambio stato: alimenta i KPI (tempo medio
// per stadio, tempo fermo auto, produttività tecnico) e la timeline
// mostrata al cliente nel portale.
model StageHistory {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  fromStage WorkflowStage?
  toStage   WorkflowStage

  changedById String?
  changedBy   User?   @relation(fields: [changedById], references: [id])

  changedAt DateTime @default(now())

  @@index([vehicleId])
  @@map("stage_history")
}

// -----------------------------
// FOTOGRAFIE
// -----------------------------

model Photo {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  fase      FasePhoto
  url       String // path su object storage (S3-compatibile)
  createdAt DateTime  @default(now())

  timeline Json @default("{}")
  timelineVersion Int @default(1)
  timelineEdits PhotoTimelineEdit[]

  // Di default visibile (comportamento storico invariato): lo staff può
  // togliere singole foto dal portale cliente senza eliminarle (es. scatti
  // di dettaglio non adatti a essere mostrati al cliente).
  visibilePortale Boolean @default(true)

  @@index([vehicleId])
  @@map("photos")
}

enum FasePhoto {
  PRIMA
  DURANTE
  DOPO
}

// -----------------------------
// PREVENTIVI
// -----------------------------

model Quote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  stato       QuoteStatus @default(BOZZA)
  imponibile  Decimal     @db.Decimal(10, 2)
  aliquotaIva Decimal     @default(22.00) @db.Decimal(4, 2)
  totale      Decimal     @db.Decimal(10, 2)

  pdfUrl    String?
  inviatoAt DateTime?
  firmaDataUrl    String?   @db.Text
  firmatarioNome  String?
  firmatoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items QuoteItem[]
  damageItems DamageItem[]
  insuranceGapAnalyses InsuranceGapAnalysis[]

  @@index([tenantId])
  @@index([tenantId, stato])
  @@map("quotes")
}

enum QuoteStatus {
  BOZZA
  INVIATO
  ACCETTATO
  RIFIUTATO
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  tipo           QuoteItemType
  descrizione    String
  quantita       Decimal       @default(1) @db.Decimal(10, 2)
  prezzoUnitario Decimal       @db.Decimal(10, 2)

  insuranceGapItems InsuranceGapItem[]

  @@map("quote_items")
}

enum QuoteItemType {
  MANODOPERA
  RICAMBIO
  VERNICE
  ALTRO
}

// -----------------------------
// AI DAMAGE ASSISTANT
// -----------------------------
// Modulo nuovo e separato dalla vecchia "Stima danni IA" (Vehicle.stimaIA,
// vedi POST /api/vehicles/:id/analizza-danni): quella resta invariata e
// continua a funzionare com'è. Questo modulo è più strutturato — un danno
// per riga invece di una stima unica testuale — pensato per generare voci
// di preventivo riga per riga, sempre con conferma umana obbligatoria.

// Una "sessione" di analisi: un gruppo di foto mandate insieme all'IA, che
// genera N DamageItem (uno per ogni danno individuato separatamente).
model DamageAnalysis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  creatoDaId String?
  creatoDa   User?   @relation(fields: [creatoDaId], references: [id])

  photoIds       Json // array di Photo.id analizzati in questa sessione
  rispostaGrezza Json? // risposta testuale grezza dell'IA: debug e miglioramento futuro del prompt

  createdAt DateTime @default(now())

  items DamageItem[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("damage_analyses")
}

// Un singolo danno individuato dall'IA. I campi "*AI" sono il risultato
// originale del modello e non vengono mai sovrascritti: restano come
// confronto con i campi correnti (modificabili dall'operatore) per capire
// dove l'IA sbaglia più spesso — base per migliorare il prompt in futuro.
model DamageItem {
  id               String         @id @default(cuid())
  damageAnalysisId String
  damageAnalysis   DamageAnalysis @relation(fields: [damageAnalysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Valori originali suggeriti dall'IA — immutabili.
  parteAI                 String
  posizioneAI             String?
  tipologiaDannoAI        String
  gravitaAI               DamageSeverity
  lavorazioneAI           String?
  necessitaSostituzioneAI Boolean @default(false)
  confidenzaPercento      Int? // 0-100: quanto l'IA è sicura di questo rilevamento
  vociPreventivoAI        Json // voci suggerite: array di {tipo, descrizione, quantita, prezzoUnitario}

  // Valori correnti: partono identici a quelli AI, l'operatore li corregge liberamente.
  parte                 String
  posizione             String?
  tipologiaDanno        String
  gravita               DamageSeverity
  lavorazioneSuggerita  String?
  necessitaSostituzione Boolean @default(false)
  vociPreventivo        Json
  noteOperatore         String?

  modificatoManualmente Boolean   @default(false)
  modificatoDaId        String?
  modificatoDa          User?     @relation(fields: [modificatoDaId], references: [id])
  modificatoAt          DateTime?

  // Preventivo bozza in cui questo danno è stato eventualmente incluso.
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([damageAnalysisId])
  @@map("damage_items")
}

enum DamageSeverity {
  LIEVE
  MEDIA
  GRAVE
}

// -----------------------------
// INSURANCE GAP ANALYSIS
// -----------------------------
// Confronto tra il preventivo interno e il documento (perizia/preventivo)
// ricevuto dall'assicurazione. Sola lettura/proposta: l'IA classifica ogni
// voce del preventivo interno come corrispondente, con differenza o
// mancante nel documento assicurazione, e suggerisce elementi da
// verificare — non dichiara mai automaticamente una voce dovuta o corretta.
// Riservato a ADMIN/AMMINISTRAZIONE (confronto importi/prezzi).

model InsuranceGapAnalysis {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id])

  sinistroId String?
  sinistro   Sinistro? @relation(fields: [sinistroId], references: [id])

  documentName    String
  documentMime    String
  documentSize    Int
  documentContent Bytes

  rispostaGrezza Json? // risposta testuale grezza dell'IA: debug e miglioramento futuro del prompt

  totalePreventivoInterno         Decimal  @db.Decimal(10, 2)
  totaleRiconosciutoAssicurazione Decimal? @db.Decimal(10, 2)
  differenza                      Decimal? @db.Decimal(10, 2)

  creatoDaId String?
  creatoDa   User?   @relation(fields: [creatoDaId], references: [id])
  createdAt  DateTime @default(now())

  items        InsuranceGapItem[]
  suggerimenti InsuranceGapSuggestion[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("insurance_gap_analyses")
}

// Una riga per ciascuna voce del preventivo interno selezionato: i campi
// "*AI" sono la lettura originale del documento assicurazione fatta
// dal modello e restano immutabili; l'operatore corregge solo i campi
// correnti (utile per capire dove l'IA legge male i documenti).
model InsuranceGapItem {
  id         String                @id @default(cuid())
  analysisId String
  analysis   InsuranceGapAnalysis  @relation(fields: [analysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  quoteItemId String
  quoteItem   QuoteItem @relation(fields: [quoteItemId], references: [id])

  // Snapshot della voce del preventivo interno al momento dell'analisi.
  descrizione    String
  tipo           QuoteItemType
  quantita       Decimal @db.Decimal(10, 2)
  prezzoUnitario Decimal @db.Decimal(10, 2)

  // Lettura originale del documento assicurazione fatta dall'IA — immutabile.
  trovatoAI                      Boolean @default(false)
  descrizioneAssicurazioneAI     String?
  quantitaAssicurazioneAI        Decimal? @db.Decimal(10, 2)
  prezzoUnitarioAssicurazioneAI  Decimal? @db.Decimal(10, 2)
  statoAI                        InsuranceGapStatus

  // Valori correnti: partono identici a quelli AI, l'operatore li corregge liberamente.
  quantitaAssicurazione       Decimal? @db.Decimal(10, 2)
  prezzoUnitarioAssicurazione Decimal? @db.Decimal(10, 2)
  stato                       InsuranceGapStatus
  noteOperatore               String?

  modificatoManualmente Boolean   @default(false)
  modificatoDaId        String?
  modificatoDa          User?     @relation(fields: [modificatoDaId], references: [id])
  modificatoAt          DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([analysisId])
  @@map("insurance_gap_items")
}

enum InsuranceGapStatus {
  CORRISPONDE
  DIFFERENZA
  MANCANTE
}

// Possibili elementi dimenticati suggeriti dall'IA, mai legati a una voce
// specifica del preventivo: solo un promemoria da verificare professionalmente.
model InsuranceGapSuggestion {
  id         String               @id @default(cuid())
  analysisId String
  analysis   InsuranceGapAnalysis @relation(fields: [analysisId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  voce     String
  motivo   String
  scartata Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([analysisId])
  @@map("insurance_gap_suggestions")
}

// -----------------------------
// MAGAZZINO RICAMBI
// -----------------------------

model Part {
 trackedParts TrackedPart[]
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  codice         String
  descrizione    String
  giacenza       Int      @default(0)
  scortaMinima   Int      @default(0)
  prezzoAcquisto Decimal  @db.Decimal(10, 2)
  prezzoVendita  Decimal? @db.Decimal(10, 2)
  fornitore      String?

  movements PartMovement[]

  @@unique([tenantId, codice])
  @@index([tenantId])
  @@map("parts")
}

model PartMovement {
  id     String @id @default(cuid())
  partId String
  part   Part   @relation(fields: [partId], references: [id])

  tipo      MovementType
  quantita  Int
  createdAt DateTime     @default(now())

  @@map("part_movements")
}

enum MovementType {
  CARICO
  SCARICO
}

// -----------------------------
// ORDINI FORNITORI
// -----------------------------

model SupplierOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  fornitore            String
  stato                OrderStatus @default(IN_ATTESA)
  dataOrdine           DateTime    @default(now())
  dataConsegnaPrevista DateTime?
  note                 String?

  items SupplierOrderItem[]

  @@index([tenantId])
  @@map("supplier_orders")
}

model SupplierOrderItem {
 trackedPart TrackedPart?
  id              String        @id @default(cuid())
  supplierOrderId String
  supplierOrder   SupplierOrder @relation(fields: [supplierOrderId], references: [id])

  // partId non è collegato con una relation esplicita a Part (come già
  // fatto per LoanerBooking.clientId): la voce d'ordine deve poter
  // esistere anche per ricambi non ancora presenti a magazzino.
  partId           String?
  descrizione      String
  quantitaOrdinata Int
  quantitaRicevuta Int      @default(0)
  prezzoUnitario   Decimal? @db.Decimal(10, 2)

  @@map("supplier_order_items")
}

enum OrderStatus {
  IN_ATTESA
  PARZIALE
  CONSEGNATO
}

// -----------------------------
// AUTO SOSTITUTIVE
// -----------------------------

model LoanerCar {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  targa       String
  marca       String
  modello     String
  disponibile Boolean @default(true)

  bookings LoanerBooking[]

  @@index([tenantId])
  @@map("loaner_cars")
}

model LoanerBooking {
  id          String    @id @default(cuid())
  loanerCarId String
  loanerCar   LoanerCar @relation(fields: [loanerCarId], references: [id])

  clientId   String
  dataInizio DateTime
  dataFine   DateTime?

  @@map("loaner_bookings")
}

// -----------------------------
// CALENDARIO / APPUNTAMENTI
// -----------------------------

model Appointment {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  titolo    String
  inizio    DateTime
  fine      DateTime
  note      String?
  tipo      String?
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])
  tecnicoId String?
  tecnico   User?    @relation("TecnicoAppuntamento", fields: [tecnicoId], references: [id])

  @@index([tenantId])
  @@map("appointments")
}

// -----------------------------
// DOCUMENTI / ORE LAVORATE
// -----------------------------

model Document {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  nome      String
  url       String
  createdAt DateTime @default(now())

  @@map("documents")
}

model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  inizio DateTime
  fine   DateTime?

  @@map("time_entries")
}

// ------------------------
// SINISTRI
// ------------------------

model Sinistro {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  numeroPratica         String?
  compagniaAssicurativa String
  perito                String?
  responsabile          String? // chi segue la pratica in carrozzeria (titolare, admin, ecc.)

  stato SinistroStatus @default(APERTO)

  importoTotale              Decimal? @db.Decimal(10, 2)
  percentualeFranchigia      Decimal? @db.Decimal(5, 2)
  importoFranchigia          Decimal? @db.Decimal(10, 2)
  importoPagatoAssicurazione Decimal  @default(0) @db.Decimal(10, 2)
  importoPagatoCliente       Decimal  @default(0) @db.Decimal(10, 2)

  dataApertura  DateTime  @default(now())
  dataChiusura  DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insuranceGapAnalyses InsuranceGapAnalysis[]

  @@index([tenantId])
  @@index([tenantId, stato])
  @@map("sinistri")
}

enum SinistroStatus {
  APERTO
  INVIATO_ASSICURAZIONE
  PERIZIA_FISSATA
  PERIZIA_COMPLETATA
  APPROVATO
  LAVORAZIONE
  COMPLETATO
  LIQUIDATO
}

// -----------------------------
// PORTALE CLIENTE
// -----------------------------

// Un link di accesso pubblico per il cliente, associato a UN SOLO
// veicolo/pratica (mai a un cliente intero: evita che vedendo un link
// si possa risalire ad altri veicoli/dati dello stesso cliente).
// Il token è la sola chiave d'accesso: nessuna password, nessun login.
model PortalAccess {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  token String @unique

  attivo         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  // Token temporaneo: scade di default 180 giorni dopo la creazione.
  // Un link scaduto o disattivato risponde come "non trovato", mai con
  // un errore che distingua i due casi (non deve rivelare se un token è
  // mai esistito).
  scadenza        DateTime?
  ultimoAccessoAt DateTime?
  numeroAccessi   Int       @default(0)

  azioni PortalAction[]

  @@index([tenantId])
  @@index([token])
  @@map("portal_access")
}

enum PortalActionTipo {
  APPROVAZIONE_PREVENTIVO
  APPROVAZIONE_INTEGRAZIONE
  FIRMA_DOCUMENTO
  RICHIESTA_CONTATTO
  RICHIESTA_RITIRO
}

// Audit log di ogni azione del cliente nel portale (approvazioni, firme,
// richieste): traccia sempre timestamp, IP e, per le richieste allo staff
// (contatto/ritiro), lo stato di gestione.
model PortalAction {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  portalAccessId String
  portalAccess   PortalAccess @relation(fields: [portalAccessId], references: [id])

  tipo         PortalActionTipo
  messaggio    String?   @db.Text
  dataRichiesta DateTime?
  ip           String?

  gestita     Boolean   @default(false)
  gestitaDaId String?
  gestitaDa   User?     @relation(fields: [gestitaDaId], references: [id])
  gestitaAt   DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([vehicleId])
  @@map("portal_actions")
}

// Documenti condivisi con il cliente tramite il portale (es. condizioni,
// informativa, dichiarazioni): byte salvati su Postgres e mai esposti con
// un URL pubblico, esattamente come i documenti di Parts Tracking e i
// documenti assicurazione di Insurance Gap Analysis.
// -----------------------------
// MODALITÀ TECNICO: lavorazioni e tracciamento ore
// -----------------------------
// Reparto: stessi 4 valori usati (in minuscolo, dentro un JSON) dal
// Predictive Delay AI (src/lib/delay.js DEPARTMENTS) — qui come enum
// Prisma nativo per le lavorazioni assegnate ai tecnici.
enum Reparto {
  CARROZZERIA
  MECCANICA
  VERNICIATURA
  FINITURA
}

enum PrioritaLavorazione {
  BASSA
  NORMALE
  ALTA
  URGENTE
}

enum WorkOrderStato {
  DA_INIZIARE
  IN_CORSO
  IN_PAUSA
  COMPLETATA
}

enum WorkOrderEventoTipo {
  CREATA
  INIZIATA
  PAUSA
  RIPRESA
  TERMINATA
  CORREZIONE_MANUALE
  RIASSEGNATA
}

// Una lavorazione assegnata a un tecnico su una pratica ("I miei lavori").
// Le ore reali non sono un campo diretto: si calcolano sempre sommando i
// segmenti in WorkOrderTimeEntry, così pausa/ripresa/correzioni restano
// sempre coerenti con lo storico invece che con un totale scollegato.
model WorkOrder {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  tecnicoId String
  tecnico   User   @relation("WorkOrderTecnico", fields: [tecnicoId], references: [id])

  titolo        String
  reparto       Reparto
  priorita      PrioritaLavorazione @default(NORMALE)
  oreStimate    Decimal             @db.Decimal(6, 2)
  noteTecniche  String?             @db.Text
  dataConsegna  DateTime?

  stato WorkOrderStato @default(DA_INIZIARE)

  creatoDaId String?
  creatoDa   User?   @relation("WorkOrderCreatore", fields: [creatoDaId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timeEntries WorkOrderTimeEntry[]
  eventi      WorkOrderEvento[]

  @@index([tenantId])
  @@index([tenantId, tecnicoId])
  @@index([vehicleId])
  @@map("work_orders")
}

// Segmenti di lavoro effettivo: un intervallo per ogni INIZIA→PAUSA/TERMINA.
// Le ore reali di una lavorazione sono sempre la somma di questi segmenti,
// mai un totale inserito a mano (le correzioni manuali modificano un
// segmento esistente, con motivo obbligatorio e tracciate in WorkOrderEvento).
model WorkOrderTimeEntry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  tecnicoId   String
  tecnico     User      @relation("WorkOrderTimeEntryTecnico", fields: [tecnicoId], references: [id])

  inizio DateTime
  fine   DateTime?

  correzioneManuale Boolean   @default(false)
  correzioneMotivo  String?   @db.Text
  correzioneDaId    String?
  correzioneDa      User?     @relation("WorkOrderTimeEntryCorrettore", fields: [correzioneDaId], references: [id])
  correzioneAt      DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([workOrderId])
  @@index([tecnicoId])
  @@map("work_order_time_entries")
}

// Storico modifiche immutabile: ogni cambio di stato e ogni correzione
// manuale, chi l'ha fatto e quando.
model WorkOrderEvento {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  tipo     WorkOrderEventoTipo
  daStato  WorkOrderStato?
  aStato   WorkOrderStato?
  dettagli Json?

  attoreId String?
  attore   User?   @relation("WorkOrderEventoAttore", fields: [attoreId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([workOrderId])
  @@map("work_order_eventi")
}

model PortalDocument {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  nome    String
  mime    String
  size    Int
  content Bytes

  richiedeFirma  Boolean   @default(false)
  firmaDataUrl   String?   @db.Text
  firmatarioNome String?
  firmatoAt      DateTime?

  caricatoDaId String?
  caricatoDa   User?   @relation(fields: [caricatoDaId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([vehicleId])
  @@map("portal_documents")
}

// -----------------------------
// UTILIZZO IA (quote/abbonamento)
// -----------------------------

// Log immutabile di ogni analisi IA completata con successo: alimenta il
// conteggio mensile usato per applicare i limiti del piano di abbonamento.
model AiAnalysisLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  vehicleId String
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_analysis_logs")
}

// Log di ogni domanda fatta all'assistente conversazionale: alimenta il
// conteggio mensile usato per applicare i limiti del piano di abbonamento.
// "domanda" è salvata solo per un eventuale controllo/debug futuro.
model AiAssistantLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  domanda   String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("ai_assistant_logs")
}

// Registro attività: chi ha fatto cosa e quando. Scritto automaticamente
// da un middleware globale (vedi audit.js) per ogni azione che modifica
// dati e per ogni tentativo respinto per permessi insufficienti.
// tenantId/userId sono nullable perché un tentativo con token mancante o
// non valido non ha un utente/tenant associato, ma vogliamo comunque
// tracciare il tentativo.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  metodo     String
  percorso   String
  statusCode Int
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// Profit Tracker: amounts in integer euro cents inside a versioned, validated ledger.
model ProfitRecord {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  vehicleId String @unique
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  data Json
  version Int @default(1)
  updatedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([tenantId])
  @@map("profit_records")
}

model ProfitSettings {
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id])
  criticalBelow Int @default(20)
  goodFrom Int @default(35)
  @@map("profit_settings")
}

// Predictive Delay AI: operational data only; no quote prices exposed.
model DelaySettings {
 tenantId String @id
 tenant Tenant @relation(fields: [tenantId], references: [id])
 data Json
 version Int @default(1)
 updatedAt DateTime @updatedAt
 @@map("delay_settings")
}
model DelayPlan {
 vehicleId String @id
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 data Json
 version Int @default(1)
 updatedById String
 updatedAt DateTime @updatedAt
 @@index([tenantId])
 @@map("delay_plans")
}
model DelayForecast {
 id String @id @default(cuid())
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 fingerprint String
 modelVersion String
 promisedAt DateTime?
 estimatedDate String?
 risk Int?
 input Json
 result Json
 actualDeliveredAt DateTime?
 createdAt DateTime @default(now())
 decisions DelayDecision[]
 @@unique([vehicleId, fingerprint])
 @@index([tenantId, createdAt])
 @@index([vehicleId, createdAt])
 @@map("delay_forecasts")
}
model DelayDecision {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 forecastId String
 forecast DelayForecast @relation(fields: [forecastId], references: [id])
 action String
 proposedDate String?
 note String
 userId String
 createdAt DateTime @default(now())
 @@index([tenantId, vehicleId, createdAt])
 @@map("delay_decisions")
}

// Parts Tracking: one operational record per practice/vehicle and ordered line.
model TrackedPart {
 id String @id @default(cuid())
 requestKey String @unique
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 orderItemId String? @unique
 orderItem SupplierOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
 catalogPartId String?
 catalogPart Part? @relation(fields: [catalogPartId], references: [id], onDelete: SetNull, onUpdate: NoAction)
 status String @default("DA_ORDINARE")
 data Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 events TrackedPartEvent[]
 documents TrackedPartDocument[]
 @@index([tenantId, vehicleId])
 @@map("tracked_parts")
}
model TrackedPartEvent {
 id String @id @default(cuid())
 partId String
 part TrackedPart @relation(fields: [partId], references: [id])
 actorId String?
 fromStatus String?
 toStatus String
 reason String
 snapshot Json
 createdAt DateTime @default(now())
 @@index([partId, createdAt])
 @@map("tracked_part_events")
}
model VehiclePartBlock {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 vehicleId String
 vehicle Vehicle @relation(fields: [vehicleId], references: [id])
 startedAt DateTime @default(now())
 endedAt DateTime?
 @@index([tenantId, vehicleId])
 @@map("vehicle_part_blocks")
}
model TrackedPartDocument {
 id String @id @default(cuid())
 tenantId String
 tenant Tenant @relation(fields: [tenantId], references: [id])
 partId String
 part TrackedPart @relation(fields: [partId], references: [id])
 name String
 mime String
 size Int
 content Bytes
 createdAt DateTime @default(now())
 @@index([tenantId, partId])
 @@map("tracked_part_documents")
}

model PhotoTimelineEdit {
 id String @id @default(cuid())
 photoId String
 photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
 actorId String
 before Json
 after Json
 createdAt DateTime @default(now())
 @@index([photoId, createdAt])
 @@map("photo_timeline_edits")
}

// -----------------------------
// COMUNICAZIONI WHATSAPP (workflow pratica)
// -----------------------------
// Inviate esclusivamente tramite Twilio come Meta Business Solution
// Provider ufficiale per WhatsApp Business (nessuna libreria non ufficiale).
// Un evento = un cambio di stato della pratica (WorkflowStage) oppure un
// evento speciale non legato allo stage (es. ricambio in ritardo, segnalato
// manualmente dall'operatore perché non è un vero cambio di stato).
// L'amministratore decide, evento per evento, se è attivo e con quale testo.

enum WhatsappEvento {
  ACCETTAZIONE
  PREVENTIVO
  ATTESA_APPROVAZIONE
  ORDINE_RICAMBI
  IN_LAVORAZIONE
  PREPARAZIONE
  VERNICIATURA
  LUCIDATURA
  CONTROLLO_QUALITA
  LAVAGGIO
  PRONTA_CONSEGNA
  CONSEGNATA
  RICAMBIO_RITARDO
}

model WhatsappTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  evento WhatsappEvento
  attivo Boolean @default(false)
  testo  String  @db.Text

  aggiornatoDaId String?
  aggiornatoDa   User?    @relation(fields: [aggiornatoDaId], references: [id])
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([tenantId, evento])
  @@index([tenantId])
  @@map("whatsapp_templates")
}

enum WhatsappMessageStato {
  INVIATO
  CONSEGNATO
  LETTO
  FALLITO
  RISPOSTA_RICEVUTA
}

// Registro immutabile di ogni messaggio WhatsApp inviato da una pratica:
// testo effettivo, stato di consegna (aggiornato dal webhook Twilio),
// eventuale errore ed eventuale risposta ricevuta dal cliente.
model WhatsappMessage {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  clientId  String
  client    Client @relation(fields: [clientId], references: [id])

  evento   WhatsappEvento
  testo    String @db.Text
  telefono String

  stato               WhatsappMessageStato @default(INVIATO)
  providerMessageSid  String?
  errore              String? @db.Text

  rispostaTesto String?   @db.Text
  rispostaAt    DateTime?

  inviatoDaId String?
  inviatoDa   User?   @relation(fields: [inviatoDaId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([vehicleId])
  @@index([providerMessageSid])
  @@map("whatsapp_messages")
}

// -----------------------------
// QUALITY CONTROL (obbligatorio prima di "Pronta")
// -----------------------------
// Checklist configurabile dal tenant: ogni riga è un controllo (chiave
// stabile + etichetta modificabile), con un flag "critico" che decide se
// un esito NON_CONFORME su quella voce blocca l'approvazione QC. Stesso
// pattern "salvato o bozza di default" già usato per WhatsappTemplate:
// finché l'admin non la personalizza, la route restituisce la checklist
// di esempio senza scrivere nulla nel database.
model QcChecklistItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  chiave    String
  etichetta String
  ordine    Int     @default(0)
  critico   Boolean @default(true)
  attivo    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, chiave])
  @@index([tenantId])
  @@map("qc_checklist_items")
}

enum QcInspectionStato {
  IN_CORSO
  APPROVATO
}

enum QcEsito {
  OK
  DA_VERIFICARE
  NON_CONFORME
  NA
}

// Un'ispezione QC per pratica: nasce con una riga QcCheckResult per ogni
// voce attiva della checklist al momento dell'avvio (così una modifica
// successiva alla checklist non altera retroattivamente ispezioni già in
// corso). Il passaggio della pratica a "Pronta" richiede che l'ultima
// ispezione sia APPROVATO — verificato in vehicles.js, non qui.
model QcInspection {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  stato QcInspectionStato @default(IN_CORSO)

  iniziataDaId String?
  iniziataDa   User?   @relation("QcInspectionIniziataDa", fields: [iniziataDaId], references: [id])

  approvatoDaId String?
  approvatoDa   User?     @relation("QcInspectionApprovataDa", fields: [approvatoDaId], references: [id])
  approvatoAt   DateTime?

  createdAt DateTime @default(now())

  checkResults    QcCheckResult[]
  nonConformita   QcNonConformita[]
  eventi          QcEvento[]

  @@index([tenantId])
  @@index([vehicleId])
  @@map("qc_inspections")
}

model QcCheckResult {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id])

  chiave    String
  etichetta String
  critico   Boolean

  esito QcEsito? // null = non ancora valutato
  note  String?  @db.Text

  aggiornatoDaId String?
  aggiornatoDa   User?     @relation(fields: [aggiornatoDaId], references: [id])
  aggiornatoAt   DateTime?

  nonConformita QcNonConformita[]

  createdAt DateTime @default(now())

  @@unique([inspectionId, chiave])
  @@index([tenantId])
  @@index([inspectionId])
  @@map("qc_check_results")
}

enum QcNonConformitaStato {
  APERTA
  IN_LAVORAZIONE
  RISOLTA
  CHIUSA
}

model QcNonConformita {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id])
  checkResultId String?
  checkResult   QcCheckResult? @relation(fields: [checkResultId], references: [id])

  descrizione String @db.Text

  fotografia     Bytes?
  fotografiaMime String?
  fotografiaSize Int?

  responsabileId String?
  responsabile   User?   @relation("QcNonConformitaResponsabile", fields: [responsabileId], references: [id])

  azioneCorrettiva String?  @db.Text
  data             DateTime @default(now())
  stato            QcNonConformitaStato @default(APERTA)

  creataDaId String?
  creataDa   User?   @relation("QcNonConformitaCreata", fields: [creataDaId], references: [id])

  chiusaAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([inspectionId])
  @@map("qc_non_conformita")
}

enum QcEventoTipo {
  ISPEZIONE_AVVIATA
  ESITO_AGGIORNATO
  NON_CONFORMITA_APERTA
  NON_CONFORMITA_AGGIORNATA
  NON_CONFORMITA_CHIUSA
  QC_APPROVATO
}

// Audit log immutabile di ogni azione QC: esiti, non conformità aperte o
// chiuse, approvazione finale — sempre con autore e timestamp.
model QcEvento {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspectionId String
  inspection   QcInspection @relation(fields: [inspectionId], references: [id])

  tipo     QcEventoTipo
  dettagli Json?

  attoreId String?
  attore   User?   @relation("QcEventoAttore", fields: [attoreId], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([inspectionId])
  @@map("qc_eventi")
}
