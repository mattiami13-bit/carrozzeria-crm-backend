# Da Supabase → Collegati al tuo progetto → ORM → Prisma
# DATABASE_URL = connessione via pooler (porta 6543), usata dall'app
# DIRECT_URL   = connessione diretta (porta 5432), usata solo dalle migrazioni
DATABASE_URL="postgresql://postgres.xxxxx:LA-TUA-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:LA-TUA-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Da Supabase → Impostazioni progetto → API. Usate anche per Storage
# (caricamento/URL firmati delle foto veicolo, bucket "vehicle-photos"):
# SUPABASE_SERVICE_ROLE_KEY bypassa ogni policy, va tenuta solo qui,
# mai esposta al frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

JWT_SECRET="cambia-questa-chiave-in-produzione"
JWT_EXPIRES_IN="8h"

# Punto 39 (feature flag): ambiente corrente, usato solo per la
# restrizione "ambienti" di un flag (array vuoto = nessuna restrizione,
# la maggior parte dei flag non la usa). Se non impostata, "production".
APP_ENV="production"

PORT=4000

# Origini browser ammesse per le chiamate all'API (separate da virgola).
# Se non impostata, usa un default sensato che include il dominio
# pubblico e localhost per lo sviluppo — vedi src/index.js.
CORS_ORIGINS="https://www.rifless.it,https://rifless.it,https://app.rifless.it,http://localhost:3000,http://localhost:5173,http://localhost:4310"

# Host su cui questo stesso servizio risponde con il gestionale invece
# che con il sito commerciale (punto 33: www.DOMINIO.it = sito,
# app.DOMINIO.it = gestionale). Va aggiunto come dominio personalizzato
# su Railway e puntato via DNS prima di funzionare — vedi PRODUCTION.md.
APP_HOSTNAME="app.rifless.it"

# Se "1" espone il frontend statico su /crm (solo per anteprima interna,
# non è il modo in cui gli utenti reali usano il gestionale oggi).
CRM_PREVIEW="0"

# Resend (email transazionali: benvenuto, verifica email, reset password)
RESEND_API_KEY=""

# Indirizzo interno a cui arrivano le notifiche di nuovi contatti
# commerciali / richieste demo (punti 34-35). Se non impostata, usa
# info@rifless.it.
CONTATTI_EMAIL_DESTINATARIO=""

# Twilio WhatsApp Business API (comunicazioni automatiche cliente)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
TWILIO_WHATSAPP_CONTENT_SID=""
TWILIO_WHATSAPP_STATUS_CALLBACK_URL=""

# Anthropic (AI Copilot, AI Damage Assistant, Insurance Gap, Predictive
# Delay AI, Morning Briefing — tutte le funzioni Premium AI)
ANTHROPIC_API_KEY=""
PHOTO_AI_MODEL=""

# Worker in-process: "0" per disattivarli (es. in un ambiente di test)
DELAY_WORKER="1"
BRIEFING_WORKER="1"
# Copia periodica (ogni 6 ore) delle foto veicolo su un secondo bucket
# Supabase separato ("vehicle-photos-backup"), a protezione da una
# cancellazione/corruzione accidentale del bucket principale.
PHOTO_BACKUP_WORKER="1"

# "1" mette il sito in manutenzione (503 + pagina dedicata) per tutti
# tranne /health. Da attivare solo per interventi pianificati.
MAINTENANCE_MODE="0"

# --- Stripe (billing) ---------------------------------------------------
# Dashboard Stripe → Sviluppatori → Chiavi API. In test usa le chiavi che
# iniziano con sk_test_/whsec_test_, in produzione quelle live sk_live_/
# whsec_live_ (create il webhook separatamente per ciascun ambiente).
STRIPE_SECRET_KEY=""
# Dashboard Stripe → Sviluppatori → Webhook → (il tuo endpoint) → Signing secret
STRIPE_WEBHOOK_SECRET=""

# Price ID per ciascun piano/periodicità: Dashboard Stripe → Product
# catalog → crea un Product per piano con due Price (mensile e annuale),
# poi incolla qui il rispettivo Price ID (inizia con "price_").
STRIPE_PRICE_STARTER_MENSILE=""
STRIPE_PRICE_STARTER_ANNUALE=""
STRIPE_PRICE_PRO_MENSILE=""
STRIPE_PRICE_PRO_ANNUALE=""
STRIPE_PRICE_PREMIUM_AI_MENSILE=""
STRIPE_PRICE_PREMIUM_AI_ANNUALE=""

# Prezzo one-time per il costo di attivazione (199€+IVA)
STRIPE_PRICE_SETUP_FEE=""
# Prezzo mensile ricorrente scontato per la promo Early Adopter (99€+IVA, primi 30)
STRIPE_PRICE_EARLY_ADOPTER_PRO=""
# Prezzo one-time per il pacchetto crediti AI aggiuntivi (500 crediti, 29€+IVA)
STRIPE_PRICE_AI_CREDITI_PACK=""
