{
  "name": "carrozzeria-crm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:profit": "node --test tests/profit.test.js tests/profit-api.test.js && node tests/check-frontend.cjs",
    "test:delay": "node --test tests/delay.test.js tests/delay-api.test.js && node tests/check-frontend.cjs",
    "test:parts": "node --test tests/parts.test.js tests/parts-api.test.js && node tests/check-frontend.cjs",
    "test:loaner": "node --test tests/loaner.test.js tests/loaner-api.test.js && node tests/check-frontend.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.45.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0",
    "resend": "^6.18.1",
    "sharp": "^0.35.4",
    "twilio": "^6.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
